    "%@ nights here are nearly always clear, by an estimate.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im %@ sind die Nächte hier fast immer klar, nach einer Schätzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nights here are nearly always clear, by an estimate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las noches de %@ aquí casi siempre están despejadas, según una estimación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@, les nuits sont presque toujours dégagées ici, selon une estimation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは%@の夜はほぼいつも晴れます（推定）。"
          }
        }
