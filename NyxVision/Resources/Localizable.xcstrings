          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻は%@"
          }
        }
      }
    },
    "To the eye, about %lld of the Little Dipper's 7 stars. An estimate, not part of the score.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
