    "Southern winter favors the bright center. Look toward the southern sky; timing and terrain matter.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Südwinter begünstigt das helle Zentrum. Schau zum südlichen Himmel; Zeitpunkt und Gelände sind wichtig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Southern winter favors the bright center. Look toward the southern sky; timing and terrain matter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El invierno austral favorece el centro brillante. Mira hacia el cielo del sur; importan la hora y el terreno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’hiver austral favorise le centre brillant. Regardez vers le ciel sud ; l’heure et le relief comptent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "南半球の冬は、明るい中心部を見るのに適しています。南の空を見てください。時間帯と地形が大切です。"
          }
        }
      }
    },
