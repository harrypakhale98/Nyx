    "Computed for %@, %@. Not a live view. Cloud forecast unavailable, so no clouds are shown, and the skyline is illustrative.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechnet für %@, %@. Keine Live-Ansicht. Die Wolkenvorhersage ist nicht verfügbar, daher werden keine Wolken gezeigt, und die Horizontlinie ist illustrativ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computed for %@, %@. Not a live view. Cloud forecast unavailable, so no clouds are shown, and the skyline is illustrative."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado para %@, %@. No es una vista en vivo. El pronóstico de nubes no está disponible, así que no se muestran nubes, y el horizonte es ilustrativo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé pour %@, %@. Pas une vue en direct. La prévision de nuages est indisponible, donc aucun nuage n’est affiché, et la ligne d’horizon est illustrative."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@、%2$@について計算した空です。リアルタイムの景色ではありません。雲予報を取得できないため雲は表示しておらず、地平線の景色はイメージです。"
          }
        }
      }
    },
