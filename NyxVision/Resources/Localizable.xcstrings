            "value": "Ausgangspunkte in den USA und ihr Umriss: U.S. Census Bureau Gazetteer Files, Bevölkerungsschätzungen und kartografische Grenzen, gemeinfrei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting points in the United States and its outline: U.S. Census Bureau Gazetteer Files, population estimates and cartographic boundaries, public domain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntos de partida en Estados Unidos y su contorno: archivos Gazetteer, estimaciones de población y límites cartográficos de la Oficina del Censo de EE. UU., dominio público."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Points de départ aux États-Unis et contour du pays : U.S. Census Bureau Gazetteer Files, estimations de population et limites cartographiques, domaine public."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "米国内の出発地と米国の輪郭：U.S. Census Bureau Gazetteer Files、人口推計、地図境界データ、パブリックドメイン。"
          }
        }
      }
    },
