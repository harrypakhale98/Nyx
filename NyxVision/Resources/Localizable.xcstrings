    "The Milky Way's bright center stays at or below the horizon this far north. Its fainter band still crosses dark skies.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Milky Way's bright center stays at or below the horizon this far north. Its fainter band still crosses dark skies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tan al norte, el centro brillante de la Vía Láctea se queda en el horizonte o por debajo. Su banda más tenue aún cruza los cielos oscuros."
          }
        }
      }
    },
    "The Moon is down all that time.": {
      "extractionState": "manual",
