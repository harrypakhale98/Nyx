    "No Moon or planets above the horizon. The stars have the sky to themselves.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Mond und keine Planeten über dem Horizont. Die Sterne haben den Himmel für sich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Moon or planets above the horizon. The stars have the sky to themselves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni la Luna ni los planetas están sobre el horizonte. Las estrellas tienen el cielo para ellas solas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni la Lune ni les planètes au-dessus de l’horizon. Les étoiles ont le ciel pour elles seules."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地平線の上に月も惑星もありません。空は星だけのものです。"
          }
        }
      }
    },
    "No alerts in the last park update. Confirm access before travel.": {
