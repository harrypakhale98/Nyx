    "Sets during the partial phase; visible %@–%@. Totality comes after moonset here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geht während der partiellen Phase unter; sichtbar %@–%@. Die Totalität kommt hier erst nach dem Monduntergang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets during the partial phase; visible %@–%@. Totality comes after moonset here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pone durante la fase parcial; visible de %@ a %@. Aquí la totalidad llega después de la puesta de la Luna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se couche pendant la phase partielle ; visible de %@ à %@. Ici, la totalité arrive après le coucher de la Lune."
          }
