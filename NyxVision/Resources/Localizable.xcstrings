          "stringUnit": {
            "state": "translated",
            "value": "La NOAA estima una actividad geomagnética de hasta Kp %lld, en su escala de 0 a 9, durante la oscuridad total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La NOAA estime l’activité géomagnétique jusqu’à Kp %lld, sur son échelle de 0 à 9, pendant l’obscurité totale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NOAAは、完全に暗い時間帯の地磁気活動を0〜9の尺度で最大Kp %lldと推定しています。"
          }
        }
      }
    },
