            "state": "translated",
            "value": "Toute la nuit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一晩中"
          }
        }
      }
    },
    "All three forecast models agree: %@ cloud.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle drei Vorhersagemodelle stimmen überein: %@ Bewölkung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All three forecast models agree: %@ cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tres modelos de pronóstico coinciden: %@ de nubes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les trois modèles de prévision concordent : %@ de nuages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3つの予報モデルが一致：雲量%@。"
          }
        }
      }
    },
    "Almost no moonlight": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast kein Mondlicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Almost no moonlight"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi sin luz de luna"
          }
        },
        "fr": {
