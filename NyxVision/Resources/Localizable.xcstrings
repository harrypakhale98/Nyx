    "A bright Moon hides all but the brightest meteors.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein heller Mond überstrahlt alle Meteore außer den hellsten."
          }
