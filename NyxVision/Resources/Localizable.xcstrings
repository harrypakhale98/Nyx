          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Farthest from the Sun's glare around %@: the best mornings to find it, %@ before sunrise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más alejado del resplandor del Sol hacia el %1$@: las mejores mañanas para encontrarlo, %2$@ antes del amanecer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au plus loin de l’éclat du Soleil vers le %1$@ : les meilleurs matins pour la trouver, %2$@ avant le lever du Soleil."
