    "%@: %lld out of 100, %@. %@ Confirm conditions and park access before traveling.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld von 100, %@. %@ Prüfe vor der Fahrt die Bedingungen und ob der Park zugänglich ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld out of 100, %@. %@ Confirm conditions and park access before traveling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld de 100, %@. %@ Confirma las condiciones y el acceso al parque antes de viajar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : %lld sur 100, %@. %@ Vérifiez les conditions et l’accès au parc avant de partir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：100点中%2$lld点、%3$@。%4$@出発前に、天候と公園に入れるかを確認してください。"
          }
        }
      }
    },
    "%@: %lld out of 100, %@. Includes a cached cloud forecast. Confirm conditions and park access before traveling.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld von 100, %@. Enthält eine gespeicherte Wolkenvorhersage. Prüfe vor der Fahrt die Bedingungen und ob der Park zugänglich ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld out of 100, %@. Includes a cached cloud forecast. Confirm conditions and park access before traveling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld de 100, %@. Incluye un pronóstico de nubes guardado. Confirma las condiciones y el acceso al parque antes de viajar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : %lld sur 100, %@. Comprend une prévision de nuages en cache. Vérifiez les conditions et l’accès au parc avant de partir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：100点中%2$lld点、%3$@。保存済みの雲予報を含みます。出発前に、天候と公園に入れるかを確認してください。"
          }
        }
      }
    },
