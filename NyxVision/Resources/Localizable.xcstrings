    "NOAA estimates geomagnetic activity up to Kp %lld on its 0 to 9 scale during true darkness.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die NOAA schätzt die geomagnetische Aktivität während der echten Dunkelheit auf bis zu Kp %lld auf ihrer Skala von 0 bis 9."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NOAA estimates geomagnetic activity up to Kp %lld on its 0 to 9 scale during true darkness."
          }
        },
