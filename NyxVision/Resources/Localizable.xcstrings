          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de Nyx no tiene clave del servicio de parques, así que no se piden alertas de los parques."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette copie de Nyx n’a pas de clé du service des parcs : les alertes des parcs ne sont donc pas demandées."
          }
        },
        "ja": {
