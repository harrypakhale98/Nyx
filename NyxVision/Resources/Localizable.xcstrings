            "value": "Besuchsstarke und ruhige Monate: Besucherstatistik des National Park Service, Monatsmittel 2021 bis 2025, CC0."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Busy and quiet months: National Park Service Visitor Use Statistics, 2021 to 2025 monthly averages, CC0."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Meses con más y menos visitantes: estadísticas de visitas del National Park Service, promedios mensuales de 2021 a 2025, CC0."
          }
