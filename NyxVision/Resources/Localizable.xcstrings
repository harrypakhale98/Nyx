            "state": "translated",
            "value": "Von diesem Park aus nicht sichtbar: Der Mond steht unter dem Horizont."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not visible from this park: the Moon is below the horizon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es visible desde este parque: la Luna está bajo el horizonte."
          }
        },
