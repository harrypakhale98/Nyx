    "From %@, it clears the terrain around %@ and drops behind it around %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von %1$@ aus steigt es gegen %2$@ über das Gelände und sinkt gegen %3$@ dahinter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From %@, it clears the terrain around %@ and drops behind it around %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde %1$@ supera el relieve (aprox. %2$@) y se oculta tras él (aprox. %3$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis %1$@, il dépasse le relief vers %2$@ et passe derrière vers %3$@."
