    "The sky stays in twilight from sunset at %@ to sunrise at %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Himmel bleibt in der Dämmerung, vom Sonnenuntergang um %@ bis zum Sonnenaufgang um %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sky stays in twilight from sunset at %@ to sunrise at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cielo sigue en crepúsculo desde la puesta del sol (%@) hasta el amanecer (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ciel reste crépusculaire du coucher du soleil, à %@, à son lever, à %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日の入り（%@）から日の出（%@）まで、空は薄明のままです。"
          }
        }
      }
    },
    "The skyline is the real terrain around %@, from elevation data.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Horizont ist das echte Gelände um %@, aus Höhendaten."
