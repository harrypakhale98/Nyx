        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geht um %@ im %@ auf und steigt vor der Morgendämmerung hoch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rises at %@ in the %@ and climbs high before dawn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale por el %2$@ (%1$@) y sube alto antes del amanecer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lève à %1$@, direction %2$@, et monte haut avant l’aube."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@に%2$@から昇り、夜明け前には高く上がります。"
          }
        }
      }
    },
