    "Farthest from the Sun's glare around %@: the best evenings to find it, %@ after sunset.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um den %1$@ am weitesten vom Glanz der Sonne entfernt: die besten Abende, um ihn zu finden, %2$@ nach Sonnenuntergang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Farthest from the Sun's glare around %@: the best evenings to find it, %@ after sunset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más alejado del resplandor del Sol hacia el %1$@: las mejores tardes para encontrarlo, %2$@ tras la puesta del Sol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au plus loin de l’éclat du Soleil vers le %1$@ : les meilleurs soirs pour la trouver, %2$@ après le coucher du Soleil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ごろ太陽のまぶしさから最も離れます。見つけるのに最適な夕方で、日没後の%2$@に見えます。"
          }
        }
      }
    },
    "Farthest from the Sun's glare around %@: the best mornings to find it, %@ before sunrise.": {
      "extractionState": "manual",
