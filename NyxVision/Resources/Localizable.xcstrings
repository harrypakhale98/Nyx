    "Rises after darkness": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgang nach Dunkelbeginn"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rises after darkness"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale después de la oscuridad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lève après l’obscurité"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗くなってから昇る"
          }
        }
      }
    },
    "Rises already in Earth's shadow; partial phase visible %@–%@. Totality is over before moonrise here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geht bereits im Erdschatten auf; partielle Phase sichtbar %@–%@. Die Totalität endet hier vor dem Mondaufgang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rises already in Earth's shadow; partial phase visible %@–%@. Totality is over before moonrise here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale ya dentro de la sombra de la Tierra; fase parcial visible de %@ a %@. Aquí la totalidad termina antes de la salida de la Luna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lève déjà dans l’ombre de la Terre ; phase partielle visible de %@ à %@. Ici, la totalité s’achève avant le lever de la Lune."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昇るときにはすでに地球の影に入っています。部分食は%@〜%@に見えます。ここでは、皆既食は月の出の前に終わります。"
          }
        }
      }
    },
    "Rises at %@ in the %@ and climbs high before dawn.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geht um %@ im %@ auf und steigt vor der Morgendämmerung hoch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rises at %@ in the %@ and climbs high before dawn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale por el %2$@ (%1$@) y sube alto antes del amanecer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lève à %1$@, direction %2$@, et monte haut avant l’aube."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@に%2$@から昇り、夜明け前には高く上がります。"
          }
        }
      }
    },
    "Rises at %@ in the %@, highest around %@, sets at %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geht um %@ im %@ auf, steht gegen %@ am höchsten, geht um %@ unter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rises at %@ in the %@, highest around %@, sets at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale por el %2$@ (%1$@); punto más alto: aprox. %3$@; se pone: %4$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lève à %1$@, direction %2$@, au plus haut vers %3$@, se couche à %4$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@に%2$@から昇り、%3$@ごろに最も高くなり、%4$@に沈みます。"
          }
        }
      }
    },
    "Rises at %@ in the %@; %@ before dawn.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geht um %@ im %@ auf; %@ vor der Morgendämmerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rises at %@ in the %@; %@ before dawn."
