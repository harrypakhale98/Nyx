          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne d’horizon est le relief réel autour de %@, d’après des données d’altitude."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
