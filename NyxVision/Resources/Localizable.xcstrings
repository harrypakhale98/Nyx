        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale por el %2$@ (%1$@); %3$@ antes del amanecer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lève à %1$@, direction %2$@ ; %3$@ avant l’aube."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@に%2$@から昇り、夜明け前には%3$@にあります。"
          }
        }
      }
    },
    "Rises at %@ in the %@; highest around %@ in the %@.": {
      "extractionState": "manual",
      "localizations": {
