    "Rises already in Earth's shadow; partial phase visible %@–%@. Totality is over before moonrise here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geht bereits im Erdschatten auf; partielle Phase sichtbar %@–%@. Die Totalität endet hier vor dem Mondaufgang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rises already in Earth's shadow; partial phase visible %@–%@. Totality is over before moonrise here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale ya dentro de la sombra de la Tierra; fase parcial visible de %@ a %@. Aquí la totalidad termina antes de la salida de la Luna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lève déjà dans l’ombre de la Terre ; phase partielle visible de %@ à %@. Ici, la totalité s’achève avant le lever de la Lune."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昇るときにはすでに地球の影に入っています。部分食は%@〜%@に見えます。ここでは、皆既食は月の出の前に終わります。"
          }
        }
      }
    },
    "Rises at %@ in the %@ and climbs high before dawn.": {
      "extractionState": "manual",
