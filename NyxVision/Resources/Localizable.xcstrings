    },
    "The solstice falls this night. At this latitude there is no true darkness.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diese Nacht fällt die Sonnenwende. In dieser Breite gibt es keine echte Dunkelheit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The solstice falls this night. At this latitude there is no true darkness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El solsticio cae esta noche. A esta latitud no hay oscuridad total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solstice tombe cette nuit. À cette latitude, il n’y a pas d’obscurité totale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この夜に至点を迎えます。この緯度では完全に暗くなりません。"
          }
        }
      }
    },
    "The solstice falls this night. True darkness lasts %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diese Nacht fällt die Sonnenwende. Echte Dunkelheit dauert %@."
          }
        },
        "en": {
