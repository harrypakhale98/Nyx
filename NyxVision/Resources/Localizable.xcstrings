    "Aurora forecast: the planetary K-index forecast of NOAA's Space Weather Prediction Center, U.S. Government work.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Polarlichtvorhersage: die Vorhersage des planetaren K-Index des Space Weather Prediction Center der NOAA, Werk der US-Regierung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aurora forecast: the planetary K-index forecast of NOAA's Space Weather Prediction Center, U.S. Government work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronóstico de auroras: el pronóstico del índice K planetario del Space Weather Prediction Center de la NOAA, obra del Gobierno de EE. UU."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévision d’aurores : la prévision de l’indice K planétaire du Space Weather Prediction Center de la NOAA, œuvre du gouvernement des États-Unis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーロラ予報：NOAAのSpace Weather Prediction Centerによる惑星K指数の予報、米国政府の著作物。"
          }
        }
      }
    },
    "Aurora latitude: computed from the International Geomagnetic Reference Field (IGRF-14, IAGA; coefficients from NOAA NCEI, U.S. Government work).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Polarlicht-Breite: berechnet aus dem International Geomagnetic Reference Field (IGRF-14, IAGA; Koeffizienten von NOAA NCEI, Werk der US-Regierung)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aurora latitude: computed from the International Geomagnetic Reference Field (IGRF-14, IAGA; coefficients from NOAA NCEI, U.S. Government work)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Latitud para las auroras: calculada a partir del Campo Geomagnético Internacional de Referencia (IGRF-14, IAGA; coeficientes de NOAA NCEI, obra del Gobierno de EE. UU.)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Latitude des aurores : calculée à partir de l’International Geomagnetic Reference Field (IGRF-14, IAGA ; coefficients de NOAA NCEI, œuvre du gouvernement des États-Unis)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーロラ緯度：国際標準地球磁場（IGRF-14、IAGA。係数はNOAA NCEI、米国政府著作物）から計算しています。"
          }
        }
      }
    },
