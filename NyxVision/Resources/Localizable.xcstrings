        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "星の名前"
          }
        }
      }
    },
    "Stars": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sterne"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stars"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estrellas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étoiles"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "星"
          }
        }
      }
    },
    "Still climbing: %lld° up in the %@ as true darkness ends.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steigt noch: %lld° hoch im %@, wenn die echte Dunkelheit endet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still climbing: %lld° up in the %@ as true darkness ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún subiendo: a %lld° en el %@ cuando termina la oscuridad total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte encore : à %lld° de hauteur, direction %@, quand l’obscurité totale prend fin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ昇っています：完全な暗さが終わるとき、%2$@の空、高度%1$lld°。"
          }
        }
      }
    },
    "Subtle: the Moon's edge darkens slightly.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezent: Der Mondrand wird etwas dunkler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtle: the Moon's edge darkens slightly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sutil: el borde de la Luna se oscurece un poco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtile : le bord de la Lune s’assombrit à peine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "わずか：月の縁が少し暗くなります。"
          }
        }
      }
    },
    "Summer favors the bright center. Look toward the southern sky; timing and terrain matter.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sommer begünstigt das helle Zentrum. Schau zum südlichen Himmel; Zeitpunkt und Gelände sind wichtig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summer favors the bright center. Look toward the southern sky; timing and terrain matter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El verano favorece el centro brillante. Mira hacia el cielo del sur; importan la hora y el terreno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’été favorise le centre brillant. Regardez vers le ciel sud ; l’heure et le relief comptent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夏は、明るい中心部を見るのに適しています。南の空を見てください。時間帯と地形が大切です。"
          }
        }
      }
    },
    "Surrounds you with this park's computed sky at the time on the clock below the window": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umgibt dich mit dem berechneten Himmel dieses Parks zur Uhrzeit unter dem Fenster"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surrounds you with this park's computed sky at the time on the clock below the window"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te rodea con el cielo calculado de este parque a la hora del reloj bajo la ventana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous entoure du ciel calculé de ce parc à l’heure de l’horloge sous la fenêtre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウの下の時計の時刻での、この公園の計算した空で、あなたを包みます"
          }
        }
      }
    },
    "Surrounds you with tonight's computed sky at a national park: the stars, the Moon and planets in their places for the park's own night.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umgibt dich mit dem berechneten Himmel von heute Nacht in einem Nationalpark: Sterne, Mond und Planeten an ihren Orten für die Nacht des Parks."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surrounds you with tonight's computed sky at a national park: the stars, the Moon and planets in their places for the park's own night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te rodea con el cielo calculado de esta noche en un parque nacional: las estrellas, la Luna y los planetas en su lugar para la noche del propio parque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous entoure du ciel calculé de ce soir dans un parc national : les étoiles, la Lune et les planètes à leur place pour la nuit du parc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国立公園の今夜の計算した空で、あなたを包みます。その公園の夜の、それぞれの位置にある星、月、惑星です。"
          }
        }
      }
    },
    "That park could not be found in the bundled library.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Park wurde in der mitgelieferten Bibliothek nicht gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That park could not be found in the bundled library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese parque no se encontró en la biblioteca incluida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce parc est introuvable dans la bibliothèque intégrée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その公園は、内蔵のライブラリに見つかりませんでした。"
          }
        }
      }
    },
    "The Milky Way's bright center stays at or below the horizon this far north. Its fainter band still crosses dark skies.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So weit im Norden bleibt das helle Zentrum der Milchstraße am oder unter dem Horizont. Ihr schwächeres Band zieht trotzdem über dunkle Himmel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Milky Way's bright center stays at or below the horizon this far north. Its fainter band still crosses dark skies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tan al norte, el centro brillante de la Vía Láctea se queda en el horizonte o por debajo. Su banda más tenue aún cruza los cielos oscuros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aussi loin au nord, le centre brillant de la Voie lactée reste au niveau de l’horizon ou en dessous. Sa bande plus pâle traverse tout de même les ciels noirs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これほど北では、天の川の明るい中心部は地平線の上に出ません。より淡い天の川の帯は、暗い空を横切ります。"
          }
        }
      }
    },
    "The Moon counts only in true darkness, and this night has none.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mond zählt nur während echter Dunkelheit, und diese Nacht hat keine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Moon counts only in true darkness, and this night has none."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Luna solo cuenta en la oscuridad total, y esta noche no la tiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Lune ne compte que pendant l’obscurité totale, et cette nuit n’en a pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月は完全に暗い時間だけで計算に入りますが、この夜にはその時間がありません。"
          }
        }
      }
    },
    "The Moon is down all that time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mond ist die ganze Zeit untergegangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Moon is down all that time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Luna está oculta todo ese tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Lune est couchée pendant tout ce temps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その間ずっと月は沈んでいます。"
          }
        }
      }
    },
    "The Moon is up all that time, %lld%% lit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mond steht die ganze Zeit am Himmel, %lld %% beleuchtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Moon is up all that time, %lld%% lit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Luna está en el cielo todo ese tiempo, %lld%% iluminada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Lune est levée pendant tout ce temps, éclairée à %lld %%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その間ずっと月が出ています。輝面比%lld%%。"
          }
        }
      }
    },
    "The Moon on your table": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mond auf deinem Tisch"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Moon on your table"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Luna en tu mesa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Lune sur votre table"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーブルの上の月"
          }
        }
      }
    },
    "The Moon rises already eclipsed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mond geht bereits verfinstert auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Moon rises already eclipsed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Luna sale ya eclipsada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Lune se lève déjà éclipsée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月は欠けた状態で昇ります。"
          }
        }
      }
    },
    "The Moon sets before it ends.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mond geht unter, bevor sie endet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Moon sets before it ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Luna se pone antes de que termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Lune se couche avant la fin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終わる前に月が沈みます。"
          }
        }
      }
    },
    "The North Unit keeps Central Time, one hour ahead of the times Nyx shows for this park.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die North Unit nutzt die Central Time, eine Stunde voraus gegenüber den Zeiten, die Nyx für diesen Park zeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The North Unit keeps Central Time, one hour ahead of the times Nyx shows for this park."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Unidad Norte usa la hora del Centro, una hora más que las horas que Nyx muestra para este parque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La North Unit est à l’heure du Centre, une heure de plus que les heures que Nyx affiche pour ce parc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "North Unitは中部時間を使っていて、Nyxがこの公園に表示する時刻より1時間進んでいます。"
          }
        }
      }
    },
    "The Sun is up": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne steht am Himmel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Sun is up"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es de día"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil est levé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "太陽が出ています"
          }
        }
      }
    },
    "The bright center is near the Sun this season. The Milky Way's fainter band still crosses dark skies.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das helle Zentrum steht in dieser Jahreszeit nahe der Sonne. Das schwächere Band der Milchstraße zieht trotzdem über dunkle Himmel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bright center is near the Sun this season. The Milky Way's fainter band still crosses dark skies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta temporada, el centro brillante está cerca del Sol. La banda más tenue de la Vía Láctea aún cruza los cielos oscuros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le centre brillant est proche du Soleil en cette saison. La bande plus pâle de la Voie lactée traverse tout de même les ciels noirs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この季節、明るい中心部は太陽の近くにあります。より淡い天の川の帯は、暗い空を横切ります。"
          }
        }
      }
    },
    "The bright center is out of the night sky this season. Bright constellations still reward a dark night.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das helle Zentrum ist in dieser Jahreszeit nicht am Nachthimmel. Helle Sternbilder lohnen eine dunkle Nacht trotzdem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bright center is out of the night sky this season. Bright constellations still reward a dark night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta temporada, el centro brillante no está en el cielo nocturno. Las constelaciones brillantes aún recompensan una noche oscura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le centre brillant est absent du ciel nocturne en cette saison. Les constellations brillantes récompensent tout de même une nuit noire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この季節、明るい中心部は夜空に出ていません。それでも暗い夜には、明るい星座が楽しめます。"
          }
        }
      }
    },
    "The bright center may be visible before dawn or near dusk. Timing and terrain matter.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das helle Zentrum ist vielleicht vor der Morgendämmerung oder nahe der Abenddämmerung sichtbar. Zeitpunkt und Gelände sind wichtig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bright center may be visible before dawn or near dusk. Timing and terrain matter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El centro brillante puede verse antes del amanecer o cerca del anochecer. Importan la hora y el terreno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le centre brillant peut être visible avant l’aube ou peu après le crépuscule. L’heure et le relief comptent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るい中心部は、夜明け前か夕暮れ近くに見えるかもしれません。時間帯と地形が大切です。"
          }
        }
      }
    },
    "The bright center rises at %@, after true darkness ends at %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das helle Zentrum geht um %@ auf, nachdem die echte Dunkelheit um %@ endet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bright center rises at %@, after true darkness ends at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El centro brillante sale (%1$@), después de que termina la oscuridad total (%2$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le centre brillant se lève à %1$@, après la fin de l’obscurité totale à %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るい中心部は%1$@に昇ります。完全な暗さが%2$@に終わった後です。"
          }
        }
      }
    },
    "The bright center sets at %@, before true darkness begins at %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das helle Zentrum geht um %@ unter, bevor die echte Dunkelheit um %@ beginnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bright center sets at %@, before true darkness begins at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El centro brillante se pone (%1$@), antes de que empiece la oscuridad total (%2$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le centre brillant se couche à %1$@, avant le début de l’obscurité totale à %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るい中心部は%1$@に沈みます。完全な暗さが%2$@に始まる前です。"
          }
        }
      }
    },
    "The bright center stays low on the horizon at this latitude. An open view to the south matters most.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dieser Breite bleibt das helle Zentrum tief am Horizont. Am wichtigsten ist eine freie Sicht nach Süden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bright center stays low on the horizon at this latitude. An open view to the south matters most."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A esta latitud, el centro brillante se queda bajo en el horizonte. Lo más importante es una vista despejada hacia el sur."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le centre brillant reste bas sur l’horizon à cette latitude. Une vue dégagée vers le sud compte plus que tout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この緯度では、明るい中心部は地平線近くの低い空にとどまります。南の視界が開けていることが何より大切です。"
          }
        }
      }
    },
    "The darkest nights of the month come in the week around it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die dunkelsten Nächte des Monats liegen in der Woche um ihn herum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The darkest nights of the month come in the week around it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las noches más oscuras del mes llegan en la semana alrededor de ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nuits les plus noires du mois tombent dans la semaine qui l’entoure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月のうちいちばん暗い夜は、その前後の1週間にあります。"
          }
        }
      }
    },
    "The next seven nights": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächsten sieben Nächte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next seven nights"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las próximas siete noches"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sept prochaines nuits"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この先7夜"
          }
        }
      }
    },
    "The next seven nights: %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächsten sieben Nächte: %@."
          }
        },
        "en": {
