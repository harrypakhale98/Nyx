    "That place could not be found in Nyx.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ort wurde in Nyx nicht gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That place could not be found in Nyx."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese lugar no se encontró en Nyx."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lieu est introuvable dans Nyx."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その場所はNyxに見つかりませんでした。"
          }
        }
      }
    },
    "That usually brings aurora low into the northern sky here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das bringt Polarlichter hier meist tief an den Nordhimmel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That usually brings aurora low into the northern sky here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso suele traer la aurora baja al cielo del norte aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela amène généralement l’aurore bas dans le ciel nord ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その場合、ここではたいてい北の低い空にオーロラが現れます。"
          }
        }
      }
    },
    "That usually brings aurora low into the southern sky here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das bringt Polarlichter hier meist tief an den Südhimmel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That usually brings aurora low into the southern sky here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso suele traer la aurora baja al cielo del sur aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela amène généralement l’aurore bas dans le ciel sud ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その場合、ここではたいてい南の低い空にオーロラが現れます。"
          }
        }
      }
    },
    "That usually brings aurora well into the northern sky here, sometimes higher.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das bringt Polarlichter hier meist weit in den Nordhimmel, manchmal höher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That usually brings aurora well into the northern sky here, sometimes higher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso suele traer la aurora bien dentro del cielo del norte aquí, a veces más alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela amène généralement l’aurore bien haut dans le ciel nord ici, parfois plus haut encore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その場合、ここではたいてい北の空の高めまでオーロラが広がり、さらに高くなることもあります。"
          }
        }
      }
    },
    "That usually brings aurora well into the southern sky here, sometimes higher.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das bringt Polarlichter hier meist weit in den Südhimmel, manchmal höher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That usually brings aurora well into the southern sky here, sometimes higher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso suele traer la aurora bien dentro del cielo del sur aquí, a veces más alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela amène généralement l’aurore bien haut dans le ciel sud ici, parfois plus haut encore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その場合、ここではたいてい南の空の高めまでオーロラが広がり、さらに高くなることもあります。"
          }
        }
      }
    },
    "The Milky Way's bright center stays at or below the horizon this far north. Its fainter band still crosses dark skies.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So weit im Norden bleibt das helle Zentrum der Milchstraße am oder unter dem Horizont. Ihr schwächeres Band zieht trotzdem über dunkle Himmel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Milky Way's bright center stays at or below the horizon this far north. Its fainter band still crosses dark skies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tan al norte, el centro brillante de la Vía Láctea se queda en el horizonte o por debajo. Su banda más tenue aún cruza los cielos oscuros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aussi loin au nord, le centre brillant de la Voie lactée reste au niveau de l’horizon ou en dessous. Sa bande plus pâle traverse tout de même les ciels noirs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これほど北では、天の川の明るい中心部は地平線の上に出ません。より淡い天の川の帯は、暗い空を横切ります。"
          }
        }
      }
    },
    "The Moon": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mond"
