          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To the eye, about %lld of the Little Dipper's 7 stars. An estimate, not part of the score."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A simple vista, unas %lld de las 7 estrellas de la Osa Menor. Es una estimación, no forma parte del índice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’œil nu, environ %lld des 7 étoiles du Petit Chariot. Une estimation, qui ne compte pas dans l’indice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肉眼で小びしゃくの7つの星のうち約%lld個。推定値で、スコアには含まれません。"
