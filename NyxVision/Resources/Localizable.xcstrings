    "Handoff offers the park and night on screen to your own devices signed in to the same Apple Account, so you can continue there.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff bietet den Park und die Nacht auf dem Bildschirm deinen eigenen Geräten an, die mit demselben Apple Account angemeldet sind, damit du dort weitermachen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff offers the park and night on screen to your own devices signed in to the same Apple Account, so you can continue there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff ofrece el parque y la noche en pantalla a tus propios dispositivos con sesión iniciada en la misma Cuenta de Apple, para que continúes allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff propose le parc et la nuit affichés à l’écran à vos propres appareils connectés au même compte Apple, pour que vous puissiez y continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
