{
  "sourceLanguage": "en",
  "strings": {
    "NSAlarmKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx sets alarms you choose for moments in the night, like the Milky Way's core rising. They are set on this device only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx programa las alarmas que eliges para momentos de la noche, como la salida del núcleo de la Vía Láctea. Se configuran solo en este dispositivo."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx uses your location on this device to find nearby national parks, notice when you are at one, and point the sky to true north. It stays on this device unless you save where you stand as a spot; then that spot's position, rounded to about 11 km, is used for its cloud forecast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx usa tu ubicación en este dispositivo para encontrar parques nacionales cercanos, saber cuándo estás en uno y orientar el cielo hacia el norte verdadero. No sale de este dispositivo, salvo que guardes como sitio el lugar donde estás; entonces la posición de ese sitio, redondeada a unos 11 km, se usa para su pronóstico de nubes."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx follows how your head turns through headphones that track motion, so the tone in field mode stays toward the part of the sky you chose. Motion never leaves this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx sigue cómo gira tu cabeza con audífonos que detectan movimiento, para que el tono del modo de campo se mantenga hacia la parte del cielo que elegiste. El movimiento nunca sale de este dispositivo."
          }
        }
      }
    },
    "Nyx Journal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx Journal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diario de Nyx"
          }
        }
      }
    },
    "Nyx Park": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx Park"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parque de Nyx"
          }
        }
      }
    }
  },
  "version": "1.0"
}
