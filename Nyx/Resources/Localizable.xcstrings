    "Parks with at least one viewing spot that nps.gov describes as step-free or partly step-free. Check with the park before you go.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Parks mit mindestens einem Beobachtungsplatz, den nps.gov als stufenlos oder teilweise stufenlos beschreibt. Erkundige dich vor der Fahrt beim Park."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parks with at least one viewing spot that nps.gov describes as step-free or partly step-free. Check with the park before you go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parques con al menos un punto de observación que nps.gov describe como sin escalones o en parte sin escalones. Consulta con el parque antes de ir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcs ayant au moins un point d’observation que nps.gov décrit comme sans marches ou en partie sans marches. Renseignez-vous auprès du parc avant de partir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "nps.govで段差なし、または一部段差なしと記載されている観察スポットが一つ以上ある公園。出かける前に公園に確認してください。"
          }
        }
      }
    },
