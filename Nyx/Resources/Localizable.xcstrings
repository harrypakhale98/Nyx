    },
    "Your constellation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Sternbild"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your constellation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu constelación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre constellation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの星座"
          }
        }
      }
    },
    "Your constellation. A map of the national parks in the lower 48 states, drawn as faint stars. Your first night will be your first star.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Sternbild. Eine Karte der Nationalparks in den 48 zusammenhängenden Bundesstaaten, als schwache Sterne gezeichnet. Deine erste Nacht wird dein erster Stern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your constellation. A map of the national parks in the lower 48 states, drawn as faint stars. Your first night will be your first star."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu constelación. Un mapa de los parques nacionales de los 48 estados contiguos, dibujados como estrellas tenues. Tu primera noche será tu primera estrella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre constellation. Une carte des parcs nationaux des 48 États contigus, dessinés comme des étoiles pâles. Votre première nuit sera votre première étoile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの星座。本土48州の国立公園を淡い星として描いた地図です。最初の夜が、最初の星になります。"
          }
        }
      }
    },
    "Your constellation. A map of the national parks in the lower 48 states, drawn as faint stars. Your journal could not be opened, so your nights are not shown.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Sternbild. Eine Karte der Nationalparks in den 48 zusammenhängenden Bundesstaaten, als schwache Sterne gezeichnet. Dein Journal konnte nicht geöffnet werden, daher werden deine Nächte nicht gezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your constellation. A map of the national parks in the lower 48 states, drawn as faint stars. Your journal could not be opened, so your nights are not shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu constelación. Un mapa de los parques nacionales de los 48 estados contiguos, dibujados como estrellas tenues. No se pudo abrir tu diario, así que tus noches no aparecen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre constellation. Une carte des parcs nationaux des 48 États contigus, dessinés comme des étoiles pâles. Votre journal n’a pas pu être ouvert : vos nuits ne sont donc pas affichées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの星座。本土48州の国立公園を淡い星として描いた地図です。ジャーナルを開けなかったため、あなたの夜は表示されていません。"
          }
        }
      }
    },
    "Your constellation. A map of the parks and dark-sky places near you, drawn as faint stars. Your first night will be your first star.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Sternbild. Eine Karte der Parks und Dunkelorte in deiner Nähe, als schwache Sterne gezeichnet. Deine erste Nacht wird dein erster Stern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your constellation. A map of the parks and dark-sky places near you, drawn as faint stars. Your first night will be your first star."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu constelación. Un mapa de los parques y lugares de cielo oscuro cercanos, dibujados como estrellas tenues. Tu primera noche será tu primera estrella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre constellation. Une carte des parcs et sites de ciel étoilé proches de vous, dessinés comme des étoiles pâles. Votre première nuit sera votre première étoile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの星座。近くの公園と暗い空の場所を淡い星として描いた地図です。最初の夜が、最初の星になります。"
          }
        }
      }
    },
    "Your constellation. A map of the parks and dark-sky places near you, drawn as faint stars. Your journal could not be opened, so your nights are not shown.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Sternbild. Eine Karte der Parks und Dunkelorte in deiner Nähe, als schwache Sterne gezeichnet. Dein Journal konnte nicht geöffnet werden, daher werden deine Nächte nicht gezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your constellation. A map of the parks and dark-sky places near you, drawn as faint stars. Your journal could not be opened, so your nights are not shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu constelación. Un mapa de los parques y lugares de cielo oscuro cercanos, dibujados como estrellas tenues. No se pudo abrir tu diario, así que tus noches no aparecen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre constellation. Une carte des parcs et sites de ciel étoilé proches de vous, dessinés comme des étoiles pâles. Votre journal n’a pas pu être ouvert : vos nuits ne sont donc pas affichées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの星座。近くの公園と暗い空の場所を淡い星として描いた地図です。ジャーナルを開けなかったため、あなたの夜は表示されていません。"
          }
        }
      }
    },
