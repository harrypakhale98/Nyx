    "Automatic turns red from dusk to dawn at the park on Tonight. Red light keeps your eyes adapted to the dark.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Automatisch“ schaltet von der Abend- bis zur Morgendämmerung am Park unter „Heute Nacht“ auf Rot. Rotes Licht erhält die Dunkeladaptation deiner Augen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic turns red from dusk to dawn at the park on Tonight. Red light keeps your eyes adapted to the dark."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático cambia a rojo del anochecer al alba en el parque de Esta noche. La luz roja mantiene tus ojos adaptados a la oscuridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En automatique, l’écran passe au rouge du crépuscule à l’aube au parc de l’onglet Ce soir. La lumière rouge garde vos yeux adaptés à l’obscurité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」にすると、「今夜」の公園で夕暮れから夜明けまで赤くなります。赤い光なら、暗さに慣れた目を保てます。"
          }
        }
      }
    },
