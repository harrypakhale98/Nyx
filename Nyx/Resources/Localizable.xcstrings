    "On the peak night of a major shower, when at least 20 an hour are expected at a saved park with the Moon down. At most one a night.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Maximumsnacht eines großen Meteorstroms, wenn in einem gespeicherten Park bei untergegangenem Mond mindestens 20 pro Stunde erwartet werden. Höchstens eine pro Nacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the peak night of a major shower, when at least 20 an hour are expected at a saved park with the Moon down. At most one a night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la noche de máximo de una lluvia importante, cuando se esperan al menos 20 por hora en un parque guardado con la Luna oculta. Como máximo, uno por noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nuit du maximum d’une grande pluie de météores, quand au moins 20 par heure sont attendus dans un parc enregistré avec la Lune couchée. Une au plus par nuit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主要な流星群の極大の夜に、月が沈んでいて、保存した公園で1時間に20個以上が予想されるとき。1夜に1回までです。"
          }
        }
      }
    },
