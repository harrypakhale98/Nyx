    "Directions use magnetic north, which can differ from true north by several degrees.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richtungen beziehen sich auf magnetisch Nord, das um mehrere Grad von geografisch Nord abweichen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Directions use magnetic north, which can differ from true north by several degrees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las direcciones usan el norte magnético, que puede diferir varios grados del norte geográfico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les directions utilisent le nord magnétique, qui peut s’écarter de plusieurs degrés du nord géographique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "方位は磁北を基準にしています。磁北は真北と数度ずれることがあります。"
