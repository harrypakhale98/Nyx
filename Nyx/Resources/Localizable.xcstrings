        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando tu ubicación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Localisation en cours"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報を取得中"
          }
        }
      }
    },
    "Finds the darkest night ahead at a park or dark-sky place, or across your saved parks, using Nyx's on-device darkness score. Clouds count only where a cached forecast reaches.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet die kommende dunkelste Nacht in einem Park oder Dunkelort oder unter deinen gespeicherten Parks, mit dem auf dem Gerät berechneten Dunkelheitswert von Nyx. Wolken zählen nur, soweit eine gespeicherte Vorhersage reicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds the darkest night ahead at a park or dark-sky place, or across your saved parks, using Nyx's on-device darkness score. Clouds count only where a cached forecast reaches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra la próxima noche más oscura en un parque o lugar de cielo oscuro, o entre tus parques guardados, con el índice de oscuridad que Nyx calcula en el dispositivo. Las nubes solo cuentan hasta donde llega un pronóstico guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve la prochaine nuit la plus noire dans un parc ou un site de ciel étoilé, ou parmi vos parcs enregistrés, avec l’indice d’obscurité que Nyx calcule sur l’appareil. Les nuages ne comptent que là où une prévision en cache existe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyxがデバイス上で計算する暗さスコアを使って、公園や暗い空の場所、または保存した公園の中から、この先いちばん暗い夜を探します。雲は、保存済みの予報が届く範囲でだけ計算に入ります。"
          }
        }
      }
    },
    "First come, first served. No reservations.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
