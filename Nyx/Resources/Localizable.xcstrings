    "Weekends only leaves no Friday or Saturday in these dates. Add a weekend or include weeknights.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „Nur Wochenenden“ bleibt in diesem Zeitraum kein Freitag oder Samstag. Füge ein Wochenende hinzu oder nimm Wochentage dazu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekends only leaves no Friday or Saturday in these dates. Add a weekend or include weeknights."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Solo fines de semana no queda ningún viernes ni sábado en estas fechas. Agrega un fin de semana o incluye noches entre semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec Week-ends seulement, il ne reste ni vendredi ni samedi dans ces dates. Ajoutez un week-end ou incluez les soirs de semaine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「週末のみ」にすると、これらの日付には金曜日も土曜日も含まれません。週末を加えるか、平日の夜も含めてください。"
          }
        }
      }
    },
