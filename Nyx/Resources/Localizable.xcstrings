    "Without true darkness at this latitude, few meteors will show.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne echte Dunkelheit auf dieser Breite werden wenige Meteore zu sehen sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
