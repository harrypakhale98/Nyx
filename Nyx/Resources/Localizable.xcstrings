    "Which of these parks and nights looks most promising, and what is still uncertain?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche dieser Parks und Nächte sind am vielversprechendsten, und was ist noch unsicher?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which of these parks and nights looks most promising, and what is still uncertain?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuáles de estos parques y noches se ven más prometedores, y qué sigue siendo incierto?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmi ces parcs et ces nuits, lesquels semblent les plus prometteurs, et qu’est-ce qui reste incertain ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの公園と夜のうち、いちばん期待できるのはどれですか？また、まだ不確かなことは何ですか？"
          }
        }
      }
    },
