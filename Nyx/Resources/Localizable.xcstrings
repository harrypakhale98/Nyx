    "Adds a note about tonight to your Nyx journal, at tonight's park.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt deinem Nyx-Journal eine Notiz über heute Nacht hinzu, beim Park von heute Nacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a note about tonight to your Nyx journal, at tonight's park."
          }
        },
        "es": {
          "stringUnit": {
