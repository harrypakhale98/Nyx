    "No city or town by that name. Try a nearby larger one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Stadt und kein Ort mit diesem Namen. Versuch einen größeren in der Nähe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No city or town by that name. Try a nearby larger one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna ciudad ni pueblo con ese nombre. Prueba con uno más grande cercano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune ville ni aucun village de ce nom. Essayez une ville plus grande à proximité."
          }
