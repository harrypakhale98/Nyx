    "Past the forecasts, the ring marks the five nights with the least moonlight. Their clouds are not known yet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jenseits der Vorhersagen markiert der Ring die fünf Nächte mit dem wenigsten Mondlicht. Ihre Wolken sind noch nicht bekannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past the forecasts, the ring marks the five nights with the least moonlight. Their clouds are not known yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más allá de los pronósticos, el anillo marca las cinco noches con menos luz de luna. Aún no se conocen sus nubes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-delà des prévisions, l’anneau marque les cinq nuits avec le moins de clair de lune. Leurs nuages ne sont pas encore connus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予報の範囲より先では、リングは月明かりの最も少ない5夜を示します。それらの夜の雲はまだわかりません。"
          }
        }
      }
    },
