    "A countdown to truly dark sky: the Sun far below the horizon and the Moon down.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Countdown bis zum wirklich dunklen Himmel: die Sonne tief unter dem Horizont, der Mond untergegangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A countdown to truly dark sky: the Sun far below the horizon and the Moon down."
