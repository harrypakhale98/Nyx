    "Programs are not checked yet. Ask at the visitor center for current night-sky programs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Programme sind noch nicht geprüft. Frag im Besucherzentrum nach aktuellen Nachthimmel-Programmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Programs are not checked yet. Ask at the visitor center for current night-sky programs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se han revisado los programas. Pregunta en el centro de visitantes por los programas de cielo nocturno actuales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les programmes n’ont pas encore été vérifiés. Renseignez-vous au centre d’accueil sur les programmes nocturnes en cours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プログラムはまだ確認していません。現在の夜空のプログラムについては、ビジターセンターで尋ねてください。"
          }
        }
      }
    },
    "Programs could not be checked in the last update. Ask at the visitor center for current night-sky programs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
