    "Shield outdoor lights so they shine down, never up.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schirme Außenleuchten ab, damit sie nach unten leuchten, nie nach oben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shield outdoor lights so they shine down, never up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubre las luces exteriores para que alumbren hacia abajo, nunca hacia arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Équipez les éclairages extérieurs d’abat-jour, pour qu’ils éclairent vers le bas, jamais vers le haut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "屋外の照明にはシェードを付けて、上ではなく下を照らすようにしましょう。"
          }
        }
      }
    },
    "Short essays on the darkness score, the Milky Way and its photos, meteors, forecasts, staying safe and sharing the night.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurze Texte über den Dunkelheitswert, die Milchstraße und ihre Fotos, Meteore, Vorhersagen, Sicherheit und das Teilen der Nacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short essays on the darkness score, the Milky Way and its photos, meteors, forecasts, staying safe and sharing the night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensayos breves sobre el índice de oscuridad, la Vía Láctea y cómo fotografiarla, los meteoros, los pronósticos, la seguridad y compartir la noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De courts essais sur l’indice d’obscurité, la Voie lactée et ses photos, les météores, les prévisions, la sécurité et le partage de la nuit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗さスコア、天の川とその写真、流星、予報、安全、夜を分かち合うことについての短いエッセイ。"
          }
        }
      }
    },
    "Short hours of true darkness limit this night to %lld.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenige Stunden echter Dunkelheit begrenzen den Wert dieser Nacht auf %lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short hours of true darkness limit this night to %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pocas horas de oscuridad total limitan esa noche a %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La brièveté de l’obscurité totale limite cette nuit à %lld."
          }
        },
        "ja": {
