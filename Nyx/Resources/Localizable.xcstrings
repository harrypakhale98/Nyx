    "Zodiacal light may show in the east before dawn: a faint cone of sunlit dust rising along the Sun's path.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor der Morgendämmerung zeigt sich im Osten vielleicht das Zodiakallicht: ein schwacher Kegel aus sonnenbeschienenem Staub, der entlang der Sonnenbahn aufsteigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodiacal light may show in the east before dawn: a faint cone of sunlit dust rising along the Sun's path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz zodiacal puede verse al este antes del amanecer: un cono tenue de polvo iluminado por el Sol que sube siguiendo su trayectoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière zodiacale peut apparaître à l’est avant l’aube : un cône pâle de poussière éclairée par le Soleil, qui s’élève le long de sa trajectoire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜明け前の東の空に、黄道光が見えるかもしれません。太陽の通り道に沿って立ちのぼる、太陽に照らされたちりのかすかな円錐です。"
          }
        }
      }
    },
    "Zodiacal light may show in the west after dusk: a faint cone of sunlit dust rising along the Sun's path.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Abenddämmerung zeigt sich im Westen vielleicht das Zodiakallicht: ein schwacher Kegel aus sonnenbeschienenem Staub, der entlang der Sonnenbahn aufsteigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodiacal light may show in the west after dusk: a faint cone of sunlit dust rising along the Sun's path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz zodiacal puede verse al oeste después del anochecer: un cono tenue de polvo iluminado por el Sol que sube siguiendo su trayectoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière zodiacale peut apparaître à l’ouest après le crépuscule : un cône pâle de poussière éclairée par le Soleil, qui s’élève le long de sa trajectoire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夕暮れ後の西の空に、黄道光が見えるかもしれません。太陽の通り道に沿って立ちのぼる、太陽に照らされたちりのかすかな円錐です。"
          }
        }
      }
    },
