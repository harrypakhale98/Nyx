    "Your next dark sky will appear here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein nächster dunkler Himmel erscheint hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next dark sky will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu próximo cielo oscuro aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre prochain ciel noir apparaîtra ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の暗い空がここに表示されます。"
          }
        }
      }
    },
    "Your nights as stars among the parks and dark-sky places, joined night to night. The ring marks the best night.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Nächte als Sterne zwischen den Parks und Dunkelorten, Nacht für Nacht verbunden. Der Ring markiert die beste Nacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your nights as stars among the parks and dark-sky places, joined night to night. The ring marks the best night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus noches como estrellas entre los parques y lugares de cielo oscuro, unidas noche a noche. El anillo marca la mejor noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos nuits en étoiles parmi les parcs et sites de ciel étoilé, reliées nuit après nuit. L’anneau marque la meilleure nuit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公園と暗い空の場所の中に星として置かれたあなたの夜を、夜から夜へとつないでいます。リングはいちばんよい夜を示します。"
          }
        }
      }
    },
    "Your observations will live here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier werden deine Beobachtungen zu Hause sein."
