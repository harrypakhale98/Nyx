    "In decimal degrees, such as 34.01, -116.18. South and west are negative. You can paste both at once.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Dezimalgrad, etwa 34.01, -116.18. Süd und West sind negativ. Du kannst beide auf einmal einfügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In decimal degrees, such as 34.01, -116.18. South and west are negative. You can paste both at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En grados decimales, como 34.01, -116.18. El sur y el oeste son negativos. Puedes pegar ambos a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En degrés décimaux, par exemple 34.01, -116.18. Le sud et l’ouest sont négatifs. Vous pouvez coller les deux à la fois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "34.01, -116.18のような10進数の度で入力します。南緯と西経はマイナスです。両方を一度に貼り付けることもできます。"
          }
        }
      }
    },
