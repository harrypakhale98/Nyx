    "Nyx scored this night %lld, %@. %@, %lld%% lit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx hat diese Nacht mit %lld bewertet, %@. %@, %lld %% beleuchtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx scored this night %lld, %@. %@, %lld%% lit."
          }
        },
        "es": {
          "stringUnit": {
