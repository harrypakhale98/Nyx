    "Ask a ranger for a permitted viewing area with an open horizon. Nyx has no verified viewing spot for this park yet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag einen Ranger nach einem erlaubten Beobachtungsbereich mit freiem Horizont. Nyx hat für diesen Park noch keinen geprüften Beobachtungsplatz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a ranger for a permitted viewing area with an open horizon. Nyx has no verified viewing spot for this park yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta a un guardaparques por una zona de observación permitida con el horizonte despejado. Nyx aún no tiene un punto de observación verificado para este parque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un ranger une zone d’observation autorisée avec un horizon dégagé. Nyx n’a pas encore de point d’observation vérifié pour ce parc."
          }
