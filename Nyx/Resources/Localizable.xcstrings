    "Tonight's Moon: its phase, how much is lit, and when it rises or sets at a park.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mond heute Nacht: seine Phase, wie viel beleuchtet ist und wann er in einem Park auf- oder untergeht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonight's Moon: its phase, how much is lit, and when it rises or sets at a park."
