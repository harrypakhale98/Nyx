    },
    "Nyx can't check closures here. Check the park's own site before you go.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx kann hier keine Sperrungen prüfen. Sieh vor der Fahrt auf der Website des Parks nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx can't check closures here. Check the park's own site before you go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx no puede comprobar los cierres aquí. Consulta el sitio del propio parque antes de ir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx ne peut pas vérifier les fermetures ici. Consultez le site du parc avant de partir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyxはここの閉鎖情報を確認できません。出かける前に、公園の公式サイトを確認してください。"
          }
        }
      }
    },
    "Nyx can't see what you looked at while you were away. Bright light resets dark adaptation.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx kann nicht sehen, wohin du geschaut hast, während du weg warst. Helles Licht setzt die Dunkeladaptation zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx can't see what you looked at while you were away. Bright light resets dark adaptation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx no puede saber qué miraste mientras no estabas. La luz intensa reinicia la adaptación a la oscuridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx ne peut pas savoir ce que vous avez regardé pendant votre absence. Une lumière vive remet l’adaptation à l’obscurité à zéro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "離れている間に何を見ていたかはNyxにはわかりません。明るい光を見ると、暗順応は最初に戻ります。"
          }
        }
      }
    },
