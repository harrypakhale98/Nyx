    "Your changes could not be stored. Try again when space is available.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Änderungen konnten nicht gesichert werden. Versuch es noch einmal, wenn wieder Speicher frei ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your changes could not be stored. Try again when space is available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar tus cambios. Inténtalo de nuevo cuando haya espacio."
