        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cielo que vale la pena proteger"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ciel qui mérite d’être protégé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "守る価値のある空"
          }
        }
      }
    },
    "A slightly lighter red that keeps text clear for red-blind and green-blind eyes. Increase Contrast turns it on too.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein etwas helleres Rot, das Text auch für rot- und grünblinde Augen gut lesbar hält. „Kontrast erhöhen“ schaltet es ebenfalls ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A slightly lighter red that keeps text clear for red-blind and green-blind eyes. Increase Contrast turns it on too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rojo un poco más claro que mantiene el texto legible para quienes no distinguen el rojo o el verde. Aumentar contraste también lo activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rouge un peu plus clair qui garde le texte lisible pour les personnes qui distinguent mal le rouge ou le vert. Augmenter le contraste l’active aussi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤と緑の色覚に違いがある人にも文字がはっきり見える、少し明るい赤です。「コントラストを上げる」がオンのときにもオンになります。"
          }
        }
      }
    },
    "A summer sky in %@, redrawn at each class. Real skies vary with the season, the weather and where you stand.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Sommerhimmel in %@, für jede Klasse neu gezeichnet. Der echte Himmel ändert sich mit Jahreszeit, Wetter und Standort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A summer sky in %@, redrawn at each class. Real skies vary with the season, the weather and where you stand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cielo de verano en %@, redibujado en cada clase. Los cielos reales cambian con la estación, el clima y el lugar donde estés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ciel d’été à %@, redessiné pour chaque classe. Le vrai ciel varie avec la saison, la météo et l’endroit où vous vous trouvez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の夏の空を、各クラスで描き直したものです。実際の空は、季節、天候、立つ場所によって変わります。"
          }
        }
      }
    },
