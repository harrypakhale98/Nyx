        },
        "es": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nyx puede poner una alarma en este iPad para un momento de la noche, como la salida del núcleo de la Vía Láctea, para que descanses hasta que el cielo esté listo. Las alarmas suenan aunque estén activados el modo Silencio o Concentración. Nada sale de este iPad."
                }
              },
