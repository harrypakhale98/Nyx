                }
              }
            }
          }
        }
      }
    },
    "Nyx reads where you are once, to save this spot. Nothing is sent unless you save it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx liest einmal deinen Standort, um diesen Platz zu speichern. Nichts wird gesendet, außer du speicherst ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx reads where you are once, to save this spot. Nothing is sent unless you save it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx lee dónde estás una vez, para guardar este sitio. No se envía nada a menos que lo guardes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx lit votre position une fois, pour enregistrer ce lieu. Rien n’est envoyé sauf si vous l’enregistrez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスポットを保存するために、Nyxは現在地を一度だけ読み取ります。保存しない限り、何も送信されません。"
          }
        }
      }
    },
