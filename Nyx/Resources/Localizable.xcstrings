          }
        }
      }
    },
    "Eyes take 20 to 30 minutes to adapt to the dark. A bright screen or a white light resets them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Augen brauchen 20 bis 30 Minuten, um sich an die Dunkelheit anzupassen. Ein heller Bildschirm oder weißes Licht setzt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyes take 20 to 30 minutes to adapt to the dark. A bright screen or a white light resets them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ojos tardan de 20 a 30 minutos en adaptarse a la oscuridad. Una pantalla brillante o una luz blanca los reinicia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut 20 à 30 minutes aux yeux pour s’adapter à l’obscurité. Un écran lumineux ou une lumière blanche les remet à zéro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目が暗さに慣れるには20〜30分かかります。明るい画面や白い光を見ると、最初に戻ってしまいます。"
          }
        }
      }
    },
