            "state": "translated",
            "value": "Überwiegend tiefe Wolken, die verbergen, was sie bedecken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostly low cloud, which hides what it covers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre todo nubes bajas, que ocultan lo que cubren."
          }
