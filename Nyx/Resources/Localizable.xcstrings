    "Faintest stars to the eye at the darkest hour: about magnitude %@, an estimate. Higher numbers are fainter stars.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwächste mit bloßem Auge sichtbare Sterne zur dunkelsten Stunde: etwa Größenklasse %@, eine Schätzung. Höhere Zahlen bedeuten schwächere Sterne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Faintest stars to the eye at the darkest hour: about magnitude %@, an estimate. Higher numbers are fainter stars."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estrellas más tenues a simple vista en la hora más oscura: magnitud de alrededor de %@, una estimación. Los números más altos son estrellas más tenues."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étoiles les plus faibles à l’œil nu au plus noir de la nuit : magnitude %@ environ, une estimation. Plus le nombre est grand, plus l’étoile est faible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばん暗い時間に肉眼で見える最も暗い星：約%@等級（推定）。数字が大きいほど暗い星です。"
          }
        }
      }
    },
