    "Worked out on this iPhone for this park. Planets are placed within about a degree; times can be a few minutes off where hills block the horizon.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Auf diesem iPad für diesen Park berechnet. Planeten sind auf etwa ein Grad genau platziert; wo Hügel den Horizont verdecken, können Zeiten um einige Minuten abweichen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Auf diesem iPhone für diesen Park berechnet. Planeten sind auf etwa ein Grad genau platziert; wo Hügel den Horizont verdecken, können Zeiten um einige Minuten abweichen."
