    "Aurora season here runs from late August to mid-April. When it shows, it also brightens the sky. Nyx does not forecast aurora.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aurora season here runs from late August to mid-April. When it shows, it also brightens the sky. Nyx does not forecast aurora."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí la temporada de auroras va de finales de agosto a mediados de abril. Cuando aparece, también ilumina el cielo. Nyx no pronostica auroras."
          }
        }
      }
    },
