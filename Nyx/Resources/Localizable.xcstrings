    },
    "Brighter stars mark darker skies. Each season's nights join into a figure. Tap a star to open its night.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hellere Sterne stehen für dunklere Himmel. Die Nächte jeder Jahreszeit fügen sich zu einer Figur. Tippe auf einen Stern, um seine Nacht zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brighter stars mark darker skies. Each season's nights join into a figure. Tap a star to open its night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estrellas más brillantes marcan cielos más oscuros. Las noches de cada temporada se unen en una figura. Toca una estrella para abrir su noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étoiles plus brillantes marquent les ciels plus noirs. Les nuits de chaque saison se relient en une figure. Touchez une étoile pour ouvrir sa nuit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るい星ほど暗い空を表します。季節ごとの夜がつながって星座になります。星をタップすると、その夜が開きます。"
          }
        }
      }
    },
