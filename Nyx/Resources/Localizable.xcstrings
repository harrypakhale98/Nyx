    "Nights marked \"No cloud forecast yet\" or \"Early look\" count each park's usual clouds for the month, in full or in part.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nächte mit „Noch keine Wolkenvorhersage“ oder „Erste Einschätzung“ rechnen ganz oder teilweise mit der üblichen Bewölkung des Parks in diesem Monat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nights marked \"No cloud forecast yet\" or \"Early look\" count each park's usual clouds for the month, in full or in part."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las noches marcadas “Aún sin pronóstico de nubes” o “Vista anticipada” cuentan la nubosidad habitual de cada parque en ese mes, total o parcialmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nuits marquées « Pas encore de prévision de nuages » ou « Tendance » comptent la nébulosité habituelle du mois pour chaque parc, en tout ou en partie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「雲予報はまだありません」または「早めの見通し」と表示された夜は、各公園のその月の平年の雲量を、全部または一部使って計算しています。"
          }
        }
      }
    },
