          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos observations vivront ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの観察がここに残ります。"
          }
        }
      }
    },
