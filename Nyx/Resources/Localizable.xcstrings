            "state": "translated",
            "value": "Los registros"
          }
        }
      }
    },
    "The ring marks the five nights in a row with the highest scores while forecasts reach them. A closure can still change the best choice.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ring marks the five nights in a row with the highest scores while forecasts reach them. A closure can still change the best choice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El anillo marca las cinco noches seguidas con los índices más altos mientras los pronósticos las alcanzan. Un cierre aún puede cambiar la mejor opción."
          }
        }
      }
    },
    "The route": {
      "extractionState": "manual",
      "localizations": {
