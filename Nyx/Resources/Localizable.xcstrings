    "Nights out, your darkest sky, and the Moons you met.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nächte draußen, dein dunkelster Himmel und die Mondphasen, die du gesehen hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nights out, your darkest sky, and the Moons you met."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus noches afuera, tu cielo más oscuro y las fases de la Luna que viste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos nuits dehors, votre ciel le plus noir et les Lunes que vous avez vues."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外で過ごした夜、いちばん暗かった空、出会った月。"
