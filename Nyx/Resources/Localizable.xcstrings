    "Find the on-device darkness estimate for a park or dark-sky place. Returns the score, 0 to 100.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermittelt die auf dem Gerät berechnete Dunkelheitsschätzung für einen Park oder Dunkelort. Gibt den Wert von 0 bis 100 zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the on-device darkness estimate for a park or dark-sky place. Returns the score, 0 to 100."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula en el dispositivo el índice de oscuridad de un parque o lugar de cielo oscuro. Devuelve el índice, de 0 a 100."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule sur l’appareil l’indice d’obscurité d’un parc ou d’un site de ciel étoilé. Renvoie l’indice, de 0 à 100."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公園や暗い空の場所の暗さを、デバイス上で推定した値で調べます。0〜100のスコアを返します。"
          }
        }
      }
    },
