    "Satellites overhead catch sunlight all through true darkness at this time of year.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Satelliten über dir werden zu dieser Jahreszeit während der ganzen echten Dunkelheit von der Sonne beschienen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Satellites overhead catch sunlight all through true darkness at this time of year."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta época, los satélites sobre ti reciben luz del sol durante toda la oscuridad total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À cette époque de l’année, les satellites au-dessus de vous captent la lumière du soleil pendant toute l’obscurité totale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時期は、完全に暗い時間のあいだずっと、頭上の人工衛星が太陽の光を反射します。"
          }
        }
      }
    },
    "Satellites overhead catch sunlight until %@ and again from %@.": {
