    "Precise Location is off for Nyx, so this is only good to a few kilometers. You can turn it on in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Genauer Standort“ ist für Nyx ausgeschaltet, daher ist dies nur auf einige Kilometer genau. Du kannst ihn in den Einstellungen einschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Precise Location is off for Nyx, so this is only good to a few kilometers. You can turn it on in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación exacta está desactivada para Nyx, así que esto solo es fiable a unos pocos kilómetros. Puedes activarla en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La position exacte est désactivée pour Nyx : celle-ci n’est donc précise qu’à quelques kilomètres près. Vous pouvez l’activer dans Réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyxの「正確な位置情報」がオフになっているため、精度は数キロメートル程度です。設定でオンにできます。"
          }
        }
      }
    },
