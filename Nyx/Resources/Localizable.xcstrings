    "The score is a planning guide, not a guarantee of visibility or safe access.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wert ist eine Planungshilfe, keine Garantie für Sicht oder sicheren Zugang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The score is a planning guide, not a guarantee of visibility or safe access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El índice es una guía para planear, no una garantía de visibilidad ni de acceso seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indice est une aide à la préparation, pas une garantie de visibilité ni d’accès sûr."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スコアは計画のための目安で、見えることや安全に行けることを保証するものではありません。"
          }
        }
      }
    },
    "The score will change as a forecast arrives.": {
      "extractionState": "manual",
      "localizations": {
