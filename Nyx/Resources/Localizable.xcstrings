    "Check your local forecast for clouds. Nyx asks for none here, so your location stays on this device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh für Wolken in deiner örtlichen Vorhersage nach. Nyx fragt hier keine ab, damit dein Standort auf diesem Gerät bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your local forecast for clouds. Nyx asks for none here, so your location stays on this device."
          }
