          }
        }
      }
    },
    "Park alerts use a key every copy of Nyx shares, limited to 1,000 requests an hour. If alerts are often busy, you can use a free key of your own from the National Park Service. It stays in this device's Keychain and is sent only to developer.nps.gov.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Park alerts use a key every copy of Nyx shares, limited to 1,000 requests an hour. If alerts are often busy, you can use a free key of your own from the National Park Service. It stays in this device's Keychain and is sent only to developer.nps.gov."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas de los parques usan una clave que comparten todas las copias de Nyx, limitada a 1,000 solicitudes por hora. Si las alertas suelen estar saturadas, puedes usar tu propia clave gratuita del National Park Service. Se guarda en el llavero de este dispositivo y solo se envía a developer.nps.gov."
          }
        }
      }
    },
    "Park data: National Park Service.": {
      "extractionState": "manual",
