    "Smoke and haze forecast from Copernicus (CAMS), the European atmosphere service. Thick smoke or haze caps the score.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rauch- und Dunstvorhersage von Copernicus (CAMS), dem europäischen Atmosphärendienst. Dichter Rauch oder Dunst begrenzt den Wert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smoke and haze forecast from Copernicus (CAMS), the European atmosphere service. Thick smoke or haze caps the score."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronóstico de humo y bruma de Copernicus (CAMS), el servicio atmosférico europeo. El humo o la bruma densos limitan el índice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévision de fumée et de brume de Copernicus (CAMS), le service européen de surveillance de l’atmosphère. Une fumée ou une brume épaisse plafonne l’indice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "煙ともやの予報は、ヨーロッパの大気サービスCopernicus（CAMS）によるものです。濃い煙やもやがあると、スコアに上限がかかります。"
          }
        }
      }
    },
