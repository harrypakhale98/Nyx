            "value": "Votre journal n’a pas pu être ouvert, donc ce fichier n’a pas été importé. Rien n’a été modifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャーナルを開けなかったため、このファイルは読み込まれませんでした。何も変更されていません。"
          }
        }
      }
    },
    "Your journal could not be opened. Everything else works. Nyx left your journal untouched.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Journal konnte nicht geöffnet werden. Alles andere funktioniert. Nyx hat dein Journal nicht angerührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your journal could not be opened. Everything else works. Nyx left your journal untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir tu diario. Todo lo demás funciona. Nyx no tocó tu diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre journal n’a pas pu être ouvert. Tout le reste fonctionne. Nyx n’a pas touché à votre journal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャーナルを開けませんでした。ほかの機能はすべて使えます。ジャーナルには手を付けていません。"
          }
        }
      }
    },
