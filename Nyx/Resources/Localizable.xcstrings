    "Scores are estimates. Check closures and the forecast before you go.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werte sind Schätzungen. Prüfe vor der Fahrt Sperrungen und Vorhersage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scores are estimates. Check closures and the forecast before you go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los índices son estimaciones. Revisa los cierres y el pronóstico antes de ir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les indices sont des estimations. Vérifiez les fermetures et la prévision avant de partir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スコアは推定値です。出かける前に閉鎖情報と予報を確認してください。"
          }
        }
      }
    },
    "Scores marked Estimate have no cloud forecast yet and use each park's usual clouds.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „Schätzung“ markierte Werte haben noch keine Wolkenvorhersage und nutzen die übliche Bewölkung jedes Parks."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scores marked Estimate have no cloud forecast yet and use each park's usual clouds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los índices marcados como Estimación aún no tienen pronóstico de nubes y usan la nubosidad habitual de cada parque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les indices marqués Estimation n’ont pas encore de prévision de nuages et utilisent la nébulosité habituelle de chaque parc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「推定」と表示されたスコアにはまだ雲予報がなく、各公園の平年の雲量を使っています。"
