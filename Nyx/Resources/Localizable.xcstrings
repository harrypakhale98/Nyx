    "Turn the screen red at any time, here or from Control Center. Nyx has no account, no ads, no tracking. Your journal never leaves this phone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Turn the screen red at any time, here or from Control Center. Nyx has no account, no ads, no tracking. Your journal never leaves this iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Turn the screen red at any time, here or from Control Center. Nyx has no account, no ads, no tracking. Your journal never leaves this phone."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Pon la pantalla en rojo cuando quieras, aquí o desde el Centro de control. Nyx no tiene cuentas, anuncios ni rastreo. Tu diario nunca sale de este iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Pon la pantalla en rojo cuando quieras, aquí o desde el Centro de control. Nyx no tiene cuentas, anuncios ni rastreo. Tu diario nunca sale de este teléfono."
                }
              }
            }
          }
        }
      }
    },
    "Turning updates off prevents new requests. Previously cached data remains available. Moon, twilight, Plan, saved parks and the journal work offline.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning updates off prevents new requests. Previously cached data remains available. Moon, twilight, Plan, saved parks and the journal work offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar las actualizaciones evita nuevas solicitudes. Los datos guardados antes siguen disponibles. La Luna, el crepúsculo, Planear, los parques guardados y el diario funcionan sin conexión."
          }
        }
      }
    },
