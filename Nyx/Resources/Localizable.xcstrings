                "stringUnit": {
                  "state": "translated",
                  "value": "Worked out on this iPhone for this park. Planets are placed within about a degree; times can be a few minutes off where hills block the horizon."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Calculado en este iPad para este parque. Los planetas se ubican con un margen de un grado; las horas pueden variar unos minutos donde las colinas tapan el horizonte."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Calculado en este iPhone para este parque. Los planetas se ubican con un margen de un grado; las horas pueden variar unos minutos donde las colinas tapan el horizonte."
                }
              }
            }
          }
        }
      }
    },
