    "A backyard, a pullout or a field you know, scored night by night like the parks. It stays on this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ein Garten, eine Haltebucht oder ein Feld, das du kennst, Nacht für Nacht bewertet wie die Parks. Der Platz bleibt auf diesem iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ein Garten, eine Haltebucht oder ein Feld, das du kennst, Nacht für Nacht bewertet wie die Parks. Der Platz bleibt auf diesem iPhone."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A backyard, a pullout or a field you know, scored night by night like the parks. It stays on this iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A backyard, a pullout or a field you know, scored night by night like the parks. It stays on this iPhone."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Un patio, un mirador junto a la carretera o un campo que conoces, con su índice noche a noche como los parques. Se queda en este iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Un patio, un mirador junto a la carretera o un campo que conoces, con su índice noche a noche como los parques. Se queda en este iPhone."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Un jardin, une aire de stationnement ou un champ que vous connaissez, noté nuit après nuit comme les parcs. Il reste sur cet iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Un jardin, une aire de stationnement ou un champ que vous connaissez, noté nuit après nuit comme les parcs. Il reste sur cet iPhone."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "自宅の庭、道路脇の待避所、よく知っている野原など。公園と同じように一夜ずつスコアを出します。このiPadの中だけに保存されます。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "自宅の庭、道路脇の待避所、よく知っている野原など。公園と同じように一夜ずつスコアを出します。このiPhoneの中だけに保存されます。"
                }
              }
            }
