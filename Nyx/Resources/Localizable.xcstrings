                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nyx sur l’iPad envoie vos parcs enregistrés et les prévisions de nuages. En attendant, les indices utilisent la nébulosité habituelle de chaque parc."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nyx sur l’iPhone envoie vos parcs enregistrés et les prévisions de nuages. En attendant, les indices utilisent la nébulosité habituelle de chaque parc."
