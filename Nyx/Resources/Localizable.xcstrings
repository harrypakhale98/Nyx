            "value": "The sky is still in twilight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cielo sigue en el crepúsculo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ciel est encore au crépuscule."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空はまだ薄明です。"
          }
        }
      }
    },
    "The sky over %@, %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Himmel über %@, %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sky over %@, %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cielo sobre %@, %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ciel à %@, %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@、%1$@の空"
          }
        }
      }
    },
    "The sky stays in twilight from sunset at %@ to sunrise at %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Himmel bleibt in der Dämmerung, vom Sonnenuntergang um %@ bis zum Sonnenaufgang um %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sky stays in twilight from sunset at %@ to sunrise at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cielo sigue en crepúsculo desde la puesta de sol, a las %@, hasta el amanecer, a las %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ciel reste crépusculaire du coucher du soleil, à %@, à son lever, à %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日の入り（%@）から日の出（%@）まで、空は薄明のままです。"
          }
        }
      }
    },
    "The spot sits at the town's point on Nyx's list, not at a particular field or hill. For somewhere outside town, use coordinates.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Platz liegt am Punkt des Orts in der Liste von Nyx, nicht auf einem bestimmten Feld oder Hügel. Für einen Platz außerhalb des Orts nutze Koordinaten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The spot sits at the town's point on Nyx's list, not at a particular field or hill. For somewhere outside town, use coordinates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sitio queda en el punto del pueblo en la lista de Nyx, no en un campo o una colina concretos. Para un lugar fuera del pueblo, usa coordenadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lieu est placé au point de la localité dans la liste de Nyx, pas sur un champ ou une colline en particulier. Pour un endroit hors de la localité, utilisez des coordonnées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスポットは、特定の野原や丘ではなく、Nyxのリストにある町の地点に置かれます。町の外の場所には、座標を使ってください。"
          }
        }
      }
    },
    "The summer Milky Way shows fine structure, and clouds look like black holes in the stars.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sommermilchstraße zeigt feine Strukturen, und Wolken wirken wie schwarze Löcher zwischen den Sternen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The summer Milky Way shows fine structure, and clouds look like black holes in the stars."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Vía Láctea de verano muestra estructura fina, y las nubes parecen hoyos negros entre las estrellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Voie lactée d’été montre une structure fine, et les nuages ressemblent à des trous noirs parmi les étoiles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夏の天の川に細かな構造が見え、雲は星の中の黒い穴のように見えます。"
          }
        }
      }
    },
    "The summit sits above most low cloud, so the score counts mid and high cloud only.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gipfel liegt über den meisten tiefen Wolken, daher zählt der Wert nur mittelhohe und hohe Wolken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The summit sits above most low cloud, so the score counts mid and high cloud only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cumbre queda por encima de casi toda la nube baja, así que el índice solo cuenta las nubes medias y altas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sommet domine la plupart des nuages bas : l’indice ne compte donc que les nuages moyens et hauts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "山頂はほとんどの低い雲より上にあるため、スコアには中層雲と上層雲だけを数えます。"
          }
        }
      }
    },
    "The time river, each calendar month and the shape of the night offer an audio graph: choose Audio Graph in the rotor to hear the nights rise and fall as a tone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zeitstrom, jeder Kalendermonat und der Verlauf der Nacht bieten ein Audiodiagramm: Wähle im Rotor „Audiodiagramm“, um die Nächte als steigenden und fallenden Ton zu hören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time river, each calendar month and the shape of the night offer an audio graph: choose Audio Graph in the rotor to hear the nights rise and fall as a tone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El río del tiempo, cada mes del calendario y la forma de la noche ofrecen una gráfica de audio: elige Gráfica de audio en el rotor para oír cómo suben y bajan las noches en un tono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La rivière du temps, chaque mois du calendrier et la forme de la nuit proposent un graphique audio : choisissez Graphique audio dans le rotor pour entendre les nuits monter et descendre en un son."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時の川、カレンダーの各月、夜のかたちでは、オーディオグラフを利用できます。ローターで「オーディオグラフ」を選ぶと、夜ごとの上がり下がりを音の高さで聞けます。"
          }
        }
      }
    },
    "The tone falls as the sky darkens and rises toward dawn. It softens while the Moon is up, more for a fuller Moon. A rising pulse is moonrise, a falling pulse moonset, and a chime the Milky Way's core rising.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ton sinkt, während der Himmel dunkler wird, und steigt zur Morgendämmerung hin. Solange der Mond am Himmel steht, wird er leiser, bei vollerem Mond stärker. Ein steigender Puls ist der Mondaufgang, ein fallender der Monduntergang und ein Glockenton der Aufgang des Milchstraßenzentrums."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tone falls as the sky darkens and rises toward dawn. It softens while the Moon is up, more for a fuller Moon. A rising pulse is moonrise, a falling pulse moonset, and a chime the Milky Way's core rising."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tono baja a medida que el cielo se oscurece y sube hacia el amanecer. Se suaviza mientras la Luna está en el cielo, más cuanto más llena está. Un pulso ascendente es la salida de la Luna; uno descendente, la puesta de la Luna, y una campanada, la salida del núcleo de la Vía Láctea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son descend à mesure que le ciel s’assombrit et remonte vers l’aube. Il s’adoucit tant que la Lune est levée, d’autant plus qu’elle est pleine. Une pulsation montante marque le lever de la Lune, une pulsation descendante son coucher, et un carillon le lever du cœur de la Voie lactée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空が暗くなるにつれて音は低くなり、夜明けに向かって高くなります。月が出ている間は音がやわらぎ、満月に近いほどやわらかくなります。上がっていく鼓動は月の出、下がっていく鼓動は月の入り、チャイムは天の川の中心部が昇ることを示します。"
          }
        }
      }
    },
    "The tone points to %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ton zeigt auf %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tone points to %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tono apunta a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son pointe vers %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音は%@の方向を示しています。"
          }
        }
      }
    },
    "The towns and cities you can start from come, in the United States, from the U.S. Census Bureau's 2025 Gazetteer Files (Places) and its Vintage 2025 population estimates, which are in the public domain, and everywhere else from GeoNames (geonames.org): every place of 15,000 people or more, under the Creative Commons Attribution 4.0 license (CC BY 4.0). Each place is a single point, not a boundary, and only straight-line distances are measured from it. A spot you save takes its time zone and region from the nearest of these places; near a border, that can be the neighbor's.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Städte und Orte, von denen du starten kannst, stammen in den USA aus den Gazetteer Files 2025 (Places) des U.S. Census Bureau und seinen Bevölkerungsschätzungen Vintage 2025, die gemeinfrei sind, und überall sonst aus GeoNames (geonames.org): jeder Ort mit 15.000 oder mehr Menschen, unter der Lizenz Creative Commons Namensnennung 4.0 (CC BY 4.0). Jeder Ort ist ein einzelner Punkt, keine Grenze, und von ihm aus werden nur Luftlinien gemessen. Ein Platz, den du speicherst, übernimmt Zeitzone und Region vom nächstgelegenen dieser Orte; nahe einer Grenze kann das der des Nachbarlands sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The towns and cities you can start from come, in the United States, from the U.S. Census Bureau's 2025 Gazetteer Files (Places) and its Vintage 2025 population estimates, which are in the public domain, and everywhere else from GeoNames (geonames.org): every place of 15,000 people or more, under the Creative Commons Attribution 4.0 license (CC BY 4.0). Each place is a single point, not a boundary, and only straight-line distances are measured from it. A spot you save takes its time zone and region from the nearest of these places; near a border, that can be the neighbor's."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pueblos y ciudades desde los que puedes partir vienen, en Estados Unidos, de los Gazetteer Files 2025 (Places) y de las estimaciones de población Vintage 2025 de la Oficina del Censo de EE. UU., que son de dominio público, y en el resto del mundo de GeoNames (geonames.org): todos los lugares de 15,000 habitantes o más, con la licencia Creative Commons Atribución 4.0 (CC BY 4.0). Cada lugar es un solo punto, no un límite, y desde él solo se miden distancias en línea recta. Un sitio que guardes toma la zona horaria y la región del más cercano de estos lugares; cerca de una frontera, puede ser la del vecino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les villes et villages d’où vous pouvez partir proviennent, aux États-Unis, des Gazetteer Files 2025 (Places) de l’U.S. Census Bureau et de ses estimations de population Vintage 2025, du domaine public, et partout ailleurs de GeoNames (geonames.org) : tous les lieux de 15 000 habitants ou plus, sous licence Creative Commons Attribution 4.0 (CC BY 4.0). Chaque lieu est un point unique, pas un territoire, et seules des distances à vol d’oiseau sont mesurées à partir de lui. Un lieu que vous enregistrez prend le fuseau horaire et la région du plus proche de ces lieux ; près d’une frontière, ce peut être ceux du voisin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出発地に選べる町や都市は、米国内ではU.S. Census Bureauの2025年Gazetteer Files（Places）とVintage 2025人口推計（パブリックドメイン）から、その他の地域ではGeoNames（geonames.org）から取得しています。GeoNamesからは人口15,000人以上のすべての場所を、Creative Commons Attribution 4.0ライセンス（CC BY 4.0）のもとで使っています。各場所は境界ではなく一つの点で、そこからは直線距離だけを測ります。保存したスポットのタイムゾーンと地域は、これらの場所のうち最も近い場所から取ります。境界の近くでは、隣の地域のものになることがあります。"
          }
        }
      }
    },
    "Then %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dann %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luego, %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に%@。"
          }
        }
      }
    },
    "There is not enough free space to open your journal. Free up some space, then open Nyx again. Everything else works, and Nyx left your journal untouched.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nicht genug Speicher frei, um dein Journal zu öffnen. Gib etwas Speicher frei und öffne Nyx dann erneut. Alles andere funktioniert, und Nyx hat dein Journal nicht angerührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is not enough free space to open your journal. Free up some space, then open Nyx again. Everything else works, and Nyx left your journal untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio libre para abrir tu diario. Libera espacio y vuelve a abrir Nyx. Todo lo demás funciona, y Nyx no tocó tu diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas assez d’espace libre pour ouvrir votre journal. Libérez de l’espace, puis rouvrez Nyx. Tout le reste fonctionne, et Nyx n’a pas touché à votre journal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャーナルを開くための空き容量が足りません。空き容量を確保してから、Nyxをもう一度開いてください。ほかの機能はすべて使えます。ジャーナルには手を付けていません。"
          }
        }
      }
    },
    "These nights have passed. Look ahead to the next new moon.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Nächte sind vorbei. Schau voraus zum nächsten Neumond."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These nights have passed. Look ahead to the next new moon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas noches ya pasaron. Mira hacia la próxima luna nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces nuits sont passées. Regardez vers la prochaine nouvelle lune."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの夜は過ぎました。次の新月を見てください。"
          }
        }
      }
    },
    "Thin high cloud; bright stars only.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünne hohe Wolken; nur helle Sterne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thin high cloud; bright stars only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nubes altas y finas; solo estrellas brillantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuages hauts et fins ; étoiles brillantes seulement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "薄い上層雲。明るい星だけが見えます。"
          }
        }
      }
    },
    "Thirty-night darkness timeline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkelheits-Zeitleiste über 30 Nächte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thirty-night darkness timeline"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Línea de tiempo de 30 noches"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frise d’obscurité sur trente nuits"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30夜の暗さのタイムライン"
          }
        }
      }
    },
    "This device has no Taptic Engine, so Nyx keeps its simple ticks. The Moon's phase is always written beside it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat keine Taptic Engine, daher bleibt Nyx bei einfachen Ticks. Die Mondphase steht immer daneben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no Taptic Engine, so Nyx keeps its simple ticks. The Moon's phase is always written beside it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene Taptic Engine, así que Nyx mantiene sus toques simples. La fase de la Luna siempre aparece escrita al lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas de Taptic Engine : Nyx garde donc ses vibrations simples. La phase de la Lune est toujours écrite à côté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにはTaptic Engineがないため、Nyxはシンプルな振動を使います。月の満ち欠けは、いつも横に文字で表示されます。"
          }
        }
      }
    },
    "This explanation is unavailable right now. The original data is ready below.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Erklärung ist gerade nicht verfügbar. Die Originaldaten stehen unten bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This explanation is unavailable right now. The original data is ready below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta explicación no está disponible ahora. Los datos originales están abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette explication n’est pas disponible pour l’instant. Les données d’origine sont prêtes ci-dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はこの説明を利用できません。元のデータは下にあります。"
          }
        }
      }
    },
    "This file could not be read as a Nyx journal. Nothing was changed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei konnte nicht als Nyx-Journal gelesen werden. Nichts wurde geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file could not be read as a Nyx journal. Nothing was changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no se pudo leer como un diario de Nyx. No se cambió nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n’a pas pu être lu comme un journal Nyx. Rien n’a été modifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルはNyxのジャーナルとして読み取れませんでした。何も変更されていません。"
          }
        }
      }
    },
    "This iPhone can't sense where it is pointing, so the sky is listed instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dieses iPad kann nicht erkennen, wohin es zeigt, daher wird der Himmel stattdessen als Liste gezeigt."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dieses iPhone kann nicht erkennen, wohin es zeigt, daher wird der Himmel stattdessen als Liste gezeigt."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
