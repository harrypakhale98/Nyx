    "Red light is on. Nyx stays red, day or night, until you change Colors in Parks.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotlicht ist eingeschaltet. Nyx bleibt rot, bei Tag und Nacht, bis du „Farben“ unter „Parks“ änderst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red light is on. Nyx stays red, day or night, until you change Colors in Parks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz roja está activada. Nyx sigue en rojo, de día o de noche, hasta que cambies Colores en Parques."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière rouge est activée. Nyx reste en rouge, de jour comme de nuit, jusqu’à ce que vous changiez Couleurs dans Parcs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤色ライトがオンです。「公園」の「色」を変えるまで、Nyxは昼も夜も赤いままです。"
          }
        }
      }
    },
    "Red light only. Nyx taps your wrist at 25 and 30 minutes, even with the screen off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Rotlicht. Nyx tippt nach 25 und 30 Minuten an dein Handgelenk, auch bei ausgeschaltetem Bildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red light only. Nyx taps your wrist at 25 and 30 minutes, even with the screen off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo luz roja. Nyx toca tu muñeca a los 25 y 30 minutos, aun con la pantalla apagada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumière rouge uniquement. Nyx tapote votre poignet à 25 et 30 minutes, même écran éteint."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤い光だけ。画面がオフでも、25分と30分の時点でNyxが手首をタップします。"
          }
        }
      }
    },
    "Red screen": {
      "extractionState": "manual",
      "localizations": {
