          "stringUnit": {
            "state": "translated",
            "value": "No Milky Way; the whole sky has a gray-white glow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay Vía Láctea; todo el cielo tiene un brillo blanco grisáceo."
