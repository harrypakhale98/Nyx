    "access.bisc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gelände auf dem Festland schließt um 17:30 Uhr. Den Nachthimmel siehst du hier nur mit Boot und beim Zelten auf einer Insel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainland grounds close at 5:30 p.m. Seeing the night sky here means a boat and island camping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las áreas en tierra firme cierran a las 5:30 p. m. Para ver el cielo nocturno aquí hay que ir en barco y acampar en una isla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les zones sur la terre ferme ferment à 17 h 30. Voir le ciel nocturne ici suppose un bateau et un camping sur une île."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本土側の敷地は午後5時30分に閉まります。ここで夜空を見るには、ボートで渡って島でキャンプする必要があります。"
          }
        }
      }
    },
    "access.chis": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur per Boot ab Ventura oder Santa Barbara erreichbar. Den Nachthimmel siehst du nur beim Zelten auf einer Insel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reached only by boat from Ventura or Santa Barbara. Seeing the night sky means camping on an island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se llega en barco desde Ventura o Santa Bárbara. Para ver el cielo nocturno hay que acampar en una isla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessible uniquement en bateau depuis Ventura ou Santa Barbara. Voir le ciel nocturne suppose de camper sur une île."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VenturaかSanta Barbaraからボートでしか行けません。夜空を見るには、島でキャンプする必要があります。"
          }
        }
      }
    },
    "access.dena": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Straßenzufahrt. Im Sommer dürfen Privatautos nur bis Savage River fahren, Meile 15 der Parkstraße."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One road entrance. In summer, private cars may drive only to Savage River, Mile 15 of the park road."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sola entrada por carretera. En verano, los autos particulares solo llegan hasta Savage River, en la milla 15 del camino del parque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule entrée par la route. En été, les voitures particulières ne peuvent aller que jusqu’à Savage River, au mile 15 de la route du parc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "道路の入口は1か所です。夏の間、自家用車で走れるのは公園道路の15マイル地点、Savage Riverまでです。"
          }
        }
      }
    },
    "access.drto": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur per Boot oder Wasserflugzeug. Den Nachthimmel siehst du beim Zelten auf Garden Key, erreichbar mit der Fähre oder dem eigenen Boot."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boat or seaplane only. Seeing the night sky means camping on Garden Key, reached by ferry or private boat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en barco o hidroavión. Para ver el cielo nocturno hay que acampar en Garden Key, al que se llega en ferry o barco privado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement en bateau ou en hydravion. Voir le ciel nocturne suppose de camper sur Garden Key, accessible en ferry ou en bateau privé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボートか水上飛行機でしか行けません。夜空を見るには、フェリーか自家用ボートで渡るGarden Keyでキャンプする必要があります。"
          }
        }
      }
    },
    "access.gaar": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Straße führt in den Park. Flieg mit einem Lufttaxi hinein oder wandere vom Dalton Highway aus und zelte im Hinterland."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No roads enter the park. Fly in by air taxi, or hike in from the Dalton Highway, and camp in the backcountry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún camino entra al parque. Llega en taxi aéreo, o a pie desde la Dalton Highway, y acampa en zonas remotas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune route n’entre dans le parc. Venez en avion-taxi, ou à pied depuis la Dalton Highway, et campez en pleine nature."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公園に入る道路はありません。エアタクシーで飛ぶか、Dalton Highwayから歩いて入り、バックカントリーでキャンプします。"
          }
        }
      }
    },
    "access.glba": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Straße führt zur Glacier Bay. Flieg oder nimm die Fähre nach Gustavus und zelte dann oder übernachte in der Lodge in Bartlett Cove."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No road leads to Glacier Bay. Fly or ferry to Gustavus, then camp or stay at the lodge in Bartlett Cove."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún camino llega a Glacier Bay. Viaja en avión o ferry a Gustavus y luego acampa o quédate en el albergue de Bartlett Cove."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune route ne mène à Glacier Bay. Rejoignez Gustavus en avion ou en ferry, puis campez ou logez au lodge de Bartlett Cove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Glacier Bayへ続く道路はありません。飛行機かフェリーでGustavusへ行き、Bartlett Coveでキャンプするか、ロッジに泊まります。"
          }
        }
      }
    },
    "access.hale": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Fahrt zum Gipfel zwischen 3 und 7 Uhr brauchst du eine Sonnenaufgangsreservierung. Übernachten nur auf Campingplätzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Driving into the summit between 3 and 7 a.m. needs a sunrise reservation. Overnight only in campgrounds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para subir en auto a la cumbre entre las 3 y las 7 a. m. se necesita una reservación para el amanecer. Solo se pernocta en campamentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monter en voiture au sommet entre 3 h et 7 h demande une réservation pour le lever du soleil. Nuitée uniquement en camping."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "午前3時から7時の間に山頂へ車で向かうには、日の出の予約が必要です。夜を過ごせるのはキャンプ場だけです。"
          }
        }
      }
    },
    "access.isro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur per Fähre oder Wasserflugzeug, Mitte Mai bis September. Vom 1. November bis 15. April geschlossen. Nachthimmel heißt hier: auf der Insel übernachten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry or seaplane only, mid-May to September. Closed Nov 1 to Apr 15. Night skies mean staying on the island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en ferry o hidroavión, de mediados de mayo a septiembre. Cerrado del 1 de noviembre al 15 de abril. Para ver el cielo nocturno hay que quedarse en la isla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement en ferry ou en hydravion, de mi-mai à septembre. Fermé du 1er novembre au 15 avril. Le ciel nocturne suppose de rester sur l’île."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フェリーか水上飛行機でしか行けません。運航は5月中旬から9月までで、11月1日から4月15日までは閉鎖されます。夜空を見るには島に泊まる必要があります。"
          }
        }
      }
    },
    "access.katm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreichbar per Kleinflugzeug oder Boot ab King Salmon. Campingplatz und Lodge in Brooks Camp sind vom 1. Juni bis 17. September geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reached by small plane or boat from King Salmon. Brooks Camp campground and lodge run June 1 to Sept 17."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se llega en avioneta o barco desde King Salmon. El campamento y el albergue de Brooks Camp abren del 1 de junio al 17 de septiembre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessible en petit avion ou en bateau depuis King Salmon. Le camping et le lodge de Brooks Camp sont ouverts du 1er juin au 17 septembre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "King Salmonから小型機かボートで行きます。Brooks Campのキャンプ場とロッジの営業は6月1日から9月17日までです。"
          }
        }
      }
    },
    "access.kefj": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit Glacier erreichst du über die Straße ab Seward. Die Fjorde selbst siehst du vom Boot oder Flugzeug aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit Glacier is reached by road from Seward. The fjords themselves are seen by boat or plane."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A Exit Glacier se llega por carretera desde Seward. Los fiordos solo se ven en barco o avión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit Glacier est accessible par la route depuis Seward. Les fjords eux-mêmes se découvrent en bateau ou en avion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit GlacierへはSewardから道路で行けます。フィヨルドそのものは、ボートか飛行機から見ます。"
          }
        }
      }
    },
    "access.kova": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Straße erreicht den Park. Flieg mit einem Lufttaxi ab Kotzebue oder Bettles; Nachthimmel heißt hier: Zelten im Hinterland."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No roads reach the park. Fly from Kotzebue or Bettles by air taxi; the night sky means backcountry camping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún camino llega al parque. Vuela en taxi aéreo desde Kotzebue o Bettles; para ver el cielo nocturno hay que acampar en zonas remotas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune route n’atteint le parc. Venez en avion-taxi depuis Kotzebue ou Bettles ; le ciel nocturne suppose de camper en pleine nature."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公園まで通じる道路はありません。KotzebueかBettlesからエアタクシーで飛びます。夜空を見るにはバックカントリーでのキャンプになります。"
          }
        }
      }
    },
    "access.lacl": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht ans Straßennetz angebunden; die meisten kommen mit dem Kleinflugzeug. Übernachten heißt Lodge oder Zelten im Hinterland."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not on the road system; most visitors arrive by small plane. Overnight means a lodge or backcountry camping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tiene acceso por carretera; la mayoría llega en avioneta. Pasar la noche significa un albergue o acampar en zonas remotas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hors du réseau routier ; la plupart des visiteurs arrivent en petit avion. Passer la nuit suppose un lodge ou un camping en pleine nature."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "道路網から外れていて、ほとんどの人は小型機で訪れます。夜を過ごすには、ロッジかバックカントリーでのキャンプになります。"
          }
        }
      }
    },
    "access.noca": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die SR 20 führt durch den Park, ist aber von November bis April hinter dem Ross Dam Trailhead meist gesperrt. Nach Stehekin führt keine Straße."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SR 20 crosses the park but usually closes past Ross Dam Trailhead, November to April. Stehekin has no road in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La SR 20 cruza el parque, pero suele cerrar más allá de Ross Dam Trailhead de noviembre a abril. A Stehekin no llega ningún camino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La SR 20 traverse le parc mais est en général fermée au-delà de Ross Dam Trailhead, de novembre à avril. Aucune route ne mène à Stehekin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SR 20が公園を横切っていますが、11月から4月はたいていRoss Dam Trailheadより先が閉鎖されます。Stehekinへ通じる道路はありません。"
          }
        }
      }
    },
    "access.npsa": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreichbar mit Flügen nach Pago Pago auf Tutuila; kleinere Flüge gehen weiter nach Ofu und Taʻū. Plane die Reise früh."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reached by flights to Pago Pago on Tutuila; smaller flights continue to Ofu and Taʻū. Plan travel early."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se llega en vuelos a Pago Pago, en Tutuila; vuelos más pequeños continúan a Ofu y Taʻū. Planea el viaje con anticipación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessible par des vols vers Pago Pago, sur Tutuila ; de plus petits vols continuent vers Ofu et Taʻū. Organisez le voyage tôt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TutuilaのPago Pagoへの便で行き、OfuとTaʻūへはさらに小さな便が続きます。早めに旅行の計画を立ててください。"
          }
        }
      }
    },
    "access.viis": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreichbar mit der Personenfähre oder der Autofähre ab St. Thomas. Zelten nur in Cinnamon Bay, mit Reservierung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reached by passenger ferry or car barge from St. Thomas. Camping is only at Cinnamon Bay, by reservation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se llega en ferry de pasajeros o en barcaza para autos desde St. Thomas. Solo se acampa en Cinnamon Bay, con reservación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessible par ferry pour passagers ou par barge à voitures depuis St. Thomas. Le camping n’est possible qu’à Cinnamon Bay, sur réservation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "St. Thomasから旅客フェリーかカーフェリーで行きます。キャンプできるのはCinnamon Bayだけで、予約が必要です。"
          }
        }
      }
    },
    "access.voya": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Besucherzentren sind mit dem Auto erreichbar. Fast jeder Zeltplatz ist nur per Boot erreichbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visitor centers are reachable by car. Nearly every campsite is reached by boat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los centros de visitantes tienen acceso en auto. Casi todos los campamentos se alcanzan en barco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les centres d’accueil sont accessibles en voiture. Presque tous les emplacements de camping se rejoignent en bateau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビジターセンターへは車で行けます。ほぼすべてのキャンプサイトへはボートで行きます。"
          }
        }
      }
    },
    "access.wrst": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei lange Schotterstraßen führen in den Park, nach McCarthy und nach Nabesna. An keiner gibt es eine Tankstelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two long gravel roads reach the park, McCarthy and Nabesna. There is no fuel along either."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos largos caminos de grava llegan al parque, McCarthy y Nabesna. No hay combustible en ninguno de los dos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux longues routes de gravier mènent au parc, McCarthy et Nabesna. Aucune n’a de station-service."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公園へはMcCarthyとNabesnaへの2本の長い砂利道で行けます。どちらの道沿いにも給油所はありません。"
          }
        }
      }
    },
    "accessible amphitheater": {
      "extractionState": "manual",
      "localizations": {
