    "Night lights around this park grew faster than around most parks between 2013 and 2025.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachtlichter rund um diesen Park haben zwischen 2013 und 2025 schneller zugenommen als bei den meisten Parks."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Night lights around this park grew faster than around most parks between 2013 and 2025."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre 2013 y 2025, las luces nocturnas alrededor de este parque crecieron más rápido que alrededor de la mayoría de los parques."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre 2013 et 2025, les lumières nocturnes autour de ce parc ont augmenté plus vite qu’autour de la plupart des parcs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2013年から2025年にかけて、この公園の周りの夜間光は、ほとんどの公園より速く増えました。"
          }
        }
      }
    },
    "Night lights around this park grew more slowly than around most parks between 2013 and 2025.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachtlichter rund um diesen Park haben zwischen 2013 und 2025 langsamer zugenommen als bei den meisten Parks."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Night lights around this park grew more slowly than around most parks between 2013 and 2025."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre 2013 y 2025, las luces nocturnas alrededor de este parque crecieron más despacio que alrededor de la mayoría de los parques."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre 2013 et 2025, les lumières nocturnes autour de ce parc ont augmenté plus lentement qu’autour de la plupart des parcs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2013年から2025年にかけて、この公園の周りの夜間光は、ほとんどの公園よりゆっくり増えました。"
          }
        }
      }
    },
