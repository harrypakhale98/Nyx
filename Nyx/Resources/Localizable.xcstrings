        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyxは%lldの国立公園を一夜ずつ比較します。どの公園へ向かい、どの夜に休みを取ればよいかがわかります。"
          }
        }
      }
    },
    "Nyx could not find those nights.": {
      "extractionState": "manual",
      "localizations": {
