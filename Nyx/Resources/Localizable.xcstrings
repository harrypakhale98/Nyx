    "The National Park Service lists no campgrounds in this park. Its website covers other places to stay nearby.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der National Park Service führt für diesen Park keine Campingplätze. Seine Website nennt andere Übernachtungsmöglichkeiten in der Nähe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The National Park Service lists no campgrounds in this park. Its website covers other places to stay nearby."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El National Park Service no registra campamentos en este parque. Su sitio web describe otros lugares para quedarse cerca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le National Park Service ne répertorie aucun camping dans ce parc. Son site présente d’autres hébergements à proximité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "National Park Serviceの情報では、この公園にキャンプ場はありません。公園のWebサイトに、近くのほかの宿泊場所が載っています。"
          }
        }
      }
    },
    "The North Unit keeps Central Time, one hour ahead of the times Nyx shows for this park.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die North Unit nutzt die Central Time, eine Stunde voraus gegenüber den Zeiten, die Nyx für diesen Park zeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The North Unit keeps Central Time, one hour ahead of the times Nyx shows for this park."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Unidad Norte usa la hora del Centro, una hora más que las horas que Nyx muestra para este parque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La North Unit est à l’heure du Centre, une heure de plus que les heures que Nyx affiche pour ce parc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "North Unitは中部時間を使っていて、Nyxがこの公園に表示する時刻より1時間進んでいます。"
          }
        }
      }
    },
    "The Sun is 18° below the horizon: %@ of true darkness, until %@.": {
      "extractionState": "manual",
      "localizations": {
