    },
    "A citizen-science project that maps light pollution from what people see. It opens in Safari; Nyx sends nothing, so you enter your night there yourself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A citizen-science project that maps light pollution from what people see. It opens in Safari; Nyx sends nothing, so you enter your night there yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un proyecto de ciencia ciudadana que mapea la contaminación lumínica a partir de lo que ve la gente. Se abre en Safari; Nyx no envía nada, así que registras tu noche allí por tu cuenta."
          }
        }
      }
    },
