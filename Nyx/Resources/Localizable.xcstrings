          "stringUnit": {
            "state": "translated",
            "value": "Bajo en el %1$@ al anochecer; se pone: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bas, direction %1$@, après le crépuscule ; se couche à %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夕暮れ後、%1$@の低い空。%2$@に沈みます。"
