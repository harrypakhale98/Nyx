    "Nyx compares national parks and dark-sky places around the world, night by night, so you know where to go and which night to take off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx vergleicht Nationalparks und Dunkelorte auf der ganzen Welt, Nacht für Nacht, damit du weißt, wohin du fährst und welche Nacht du dir freinimmst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx compares national parks and dark-sky places around the world, night by night, so you know where to go and which night to take off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx compara parques nacionales y lugares de cielo oscuro de todo el mundo, noche a noche, para que sepas adónde ir y qué noche tomarte libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx compare les parcs nationaux et les sites de ciel étoilé du monde entier, nuit après nuit, pour que vous sachiez où aller et quelle nuit prendre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyxは世界の国立公園と暗い空の場所を一夜ずつ比較します。どこへ行き、どの夜に休みを取ればよいかがわかります。"
          }
        }
      }
    },
    "Nyx compares the %lld national parks night by night, so you know which park to drive to and which night to take off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx vergleicht die %lld Nationalparks Nacht für Nacht, damit du weißt, zu welchem Park du fährst und welche Nacht du dir freinimmst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx compares the %lld national parks night by night, so you know which park to drive to and which night to take off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx compara los %lld parques nacionales noche a noche, para que sepas a qué parque manejar y qué noche tomarte libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx compare les %lld parcs nationaux nuit après nuit, pour que vous sachiez vers quel parc rouler et quelle nuit prendre."
