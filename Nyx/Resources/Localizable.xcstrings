    "VoiceOver reads this when the photo is shown.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver liest das vor, wenn das Foto angezeigt wird."
          }
        },
