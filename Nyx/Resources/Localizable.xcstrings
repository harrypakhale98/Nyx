    "This is where you are now. If you save it, its rounded position is asked about like any spot's. If you don't, nothing is sent.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier bist du gerade. Wenn du diesen Platz speicherst, wird seine gerundete Position wie bei jedem Platz abgefragt. Wenn nicht, wird nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is where you are now. If you save it, its rounded position is asked about like any spot's. If you don't, nothing is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí es donde estás ahora. Si lo guardas, su posición redondeada se consulta como la de cualquier sitio. Si no, no se envía nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes ici. Si vous enregistrez ce lieu, sa position arrondie est demandée comme pour n’importe quel lieu. Sinon, rien n’est envoyé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここが今いる場所です。保存すると、ほかのスポットと同じように丸めた位置で問い合わせます。保存しなければ、何も送信されません。"
          }
        }
      }
    },
