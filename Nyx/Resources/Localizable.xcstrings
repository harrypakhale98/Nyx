    "Saved on this iPhone. Clouds at your saved spots is off in Your privacy, so this spot uses its usual clouds.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Auf diesem iPad gespeichert. „Wolken an deinen gespeicherten Plätzen“ ist unter „Deine Privatsphäre“ ausgeschaltet, daher nutzt dieser Platz seine übliche Bewölkung."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Auf diesem iPhone gespeichert. „Wolken an deinen gespeicherten Plätzen“ ist unter „Deine Privatsphäre“ ausgeschaltet, daher nutzt dieser Platz seine übliche Bewölkung."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Saved on this iPad. Clouds at your saved spots is off in Your privacy, so this spot uses its usual clouds."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Saved on this iPhone. Clouds at your saved spots is off in Your privacy, so this spot uses its usual clouds."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Guardado en este iPad. Nubes en tus sitios guardados está desactivado en Tu privacidad, así que este sitio usa sus nubes habituales."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Guardado en este iPhone. Nubes en tus sitios guardados está desactivado en Tu privacidad, así que este sitio usa sus nubes habituales."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Enregistré sur cet iPad. Nuages à vos lieux enregistrés est désactivé dans Votre vie privée, donc ce lieu utilise sa nébulosité habituelle."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Enregistré sur cet iPhone. Nuages à vos lieux enregistrés est désactivé dans Votre vie privée, donc ce lieu utilise sa nébulosité habituelle."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "このiPadに保存しました。「あなたのプライバシー」で「保存したスポットの雲」がオフになっているため、このスポットには平年の雲量を使います。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
