    "Puts a night's countdown at a park or dark-sky place on your Lock Screen. It starts by itself before sunset; Nyx does not need to be open.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt den Countdown einer Nacht in einem Park oder Dunkelort auf deinen Sperrbildschirm. Er startet vor Sonnenuntergang von selbst; Nyx muss nicht geöffnet sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts a night's countdown at a park or dark-sky place on your Lock Screen. It starts by itself before sunset; Nyx does not need to be open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone en tu pantalla bloqueada la cuenta regresiva de una noche en un parque o lugar de cielo oscuro. Empieza sola antes de la puesta del sol; no hace falta abrir Nyx."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche sur votre écran verrouillé le compte à rebours d’une nuit dans un parc ou un site de ciel étoilé. Il démarre tout seul avant le coucher du soleil ; Nyx n’a pas besoin d’être ouvert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公園や暗い空の場所での夜のカウントダウンをロック画面に表示します。日の入り前に自動で始まり、Nyxを開いておく必要はありません。"
          }
        }
      }
    },
    "Puts the night's countdown on your Lock Screen before sunset, without opening Nyx.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt den Countdown der Nacht vor Sonnenuntergang auf deinen Sperrbildschirm, ohne Nyx zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts the night's countdown on your Lock Screen before sunset, without opening Nyx."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone la cuenta regresiva de la noche en tu pantalla bloqueada antes de la puesta del sol, sin abrir Nyx."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le compte à rebours de la nuit sur votre écran verrouillé avant le coucher du soleil, sans ouvrir Nyx."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyxを開かなくても、日の入り前に夜のカウントダウンをロック画面に表示します。"
          }
        }
      }
    },
