    "This device has no Taptic Engine, so Nyx keeps its simple ticks. The Moon's phase is always written beside it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no Taptic Engine, so Nyx keeps its simple ticks. The Moon's phase is always written beside it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene Taptic Engine, así que Nyx mantiene sus toques simples. La fase de la Luna siempre aparece escrita al lado."
          }
        }
      }
    },
    "This explanation is unavailable right now. The original data is ready below.": {
      "extractionState": "manual",
      "localizations": {
