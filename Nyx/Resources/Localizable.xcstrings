          "stringUnit": {
            "state": "translated",
            "value": "Nyx could not find those nights."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx no pudo encontrar esas noches."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx n’a pas trouvé ces nuits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyxはそれらの夜を見つけられませんでした。"
          }
        }
      }
    },
    "Nyx could not find those nights. They may have passed; ask again for the nights ahead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx konnte diese Nächte nicht finden. Vielleicht sind sie vorbei; frag noch einmal nach den kommenden Nächten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx could not find those nights. They may have passed; ask again for the nights ahead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx no encontró esas noches. Puede que ya hayan pasado; vuelve a preguntar por las próximas noches."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyx n’a pas trouvé ces nuits. Elles sont peut-être passées ; redemandez pour les nuits à venir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyxはそれらの夜を見つけられませんでした。すでに過ぎた夜かもしれません。この先の夜についてもう一度尋ねてください。"
          }
        }
      }
    },
    "Nyx could not match an answer to these records. The original data is below.": {
