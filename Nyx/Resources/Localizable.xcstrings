        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta el pronóstico local para saber si habrá nubes. Nyx no pide ninguno aquí, así que tu ubicación se queda en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
