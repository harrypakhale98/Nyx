    "Moves the Tonight's sky widget to your next saved park, in order of tonight's score. Tomorrow it returns to your darkest park.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt das Widget „Himmel heute Nacht“ auf deinen nächsten gespeicherten Park um, geordnet nach dem Wert für heute Nacht. Morgen kehrt es zu deinem dunkelsten Park zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves the Tonight's sky widget to your next saved park, in order of tonight's score. Tomorrow it returns to your darkest park."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el widget Cielo de esta noche a tu siguiente parque guardado, según el índice de esta noche. Mañana vuelve a tu parque más oscuro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe le widget Ciel de ce soir à votre parc enregistré suivant, dans l’ordre de l’indice de ce soir. Demain, il revient à votre parc le plus sombre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今夜の空」ウィジェットを、今夜のスコア順で次の保存した公園に切り替えます。明日はいちばん暗い公園に戻ります。"
          }
        }
      }
    },
