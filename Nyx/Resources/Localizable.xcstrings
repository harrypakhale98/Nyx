    "access.bisc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainland grounds close at 5:30 p.m. Seeing the night sky here means a boat and island camping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las áreas en tierra firme cierran a las 5:30 p. m. Para ver el cielo nocturno aquí hay que ir en barco y acampar en una isla."
          }
        }
      }
    },
    "access.chis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reached only by boat from Ventura or Santa Barbara. Seeing the night sky means camping on an island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se llega en barco desde Ventura o Santa Bárbara. Para ver el cielo nocturno hay que acampar en una isla."
          }
        }
      }
    },
    "access.dena": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One road entrance. In summer, private cars may drive only to Savage River, Mile 15 of the park road."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sola entrada por carretera. En verano, los autos particulares solo llegan hasta Savage River, en la milla 15 del camino del parque."
          }
        }
      }
    },
    "access.drto": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boat or seaplane only. Seeing the night sky means camping on Garden Key, reached by ferry or private boat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en barco o hidroavión. Para ver el cielo nocturno hay que acampar en Garden Key, al que se llega en ferry o barco privado."
          }
        }
      }
    },
    "access.gaar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No roads enter the park. Fly in by air taxi, or hike in from the Dalton Highway, and camp in the backcountry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún camino entra al parque. Llega en taxi aéreo, o a pie desde la Dalton Highway, y acampa en zonas remotas."
          }
        }
      }
    },
    "access.glba": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No road leads to Glacier Bay. Fly or ferry to Gustavus, then camp or stay at the lodge in Bartlett Cove."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún camino llega a Glacier Bay. Viaja en avión o ferry a Gustavus y luego acampa o quédate en el albergue de Bartlett Cove."
          }
        }
      }
    },
    "access.hale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Driving into the summit between 3 and 7 a.m. needs a sunrise reservation. Overnight only in campgrounds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para subir en auto a la cumbre entre las 3 y las 7 a. m. se necesita una reservación para el amanecer. Solo se pernocta en campamentos."
          }
        }
      }
    },
    "access.isro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry or seaplane only, mid-May to September. Closed Nov 1 to Apr 15. Night skies mean staying on the island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en ferry o hidroavión, de mediados de mayo a septiembre. Cerrado del 1 de noviembre al 15 de abril. Para ver el cielo nocturno hay que quedarse en la isla."
          }
        }
      }
    },
    "access.katm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reached by small plane or boat from King Salmon. Brooks Camp campground and lodge run June 1 to Sept 17."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se llega en avioneta o barco desde King Salmon. El campamento y el albergue de Brooks Camp abren del 1 de junio al 17 de septiembre."
          }
        }
      }
    },
    "access.kefj": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit Glacier is reached by road from Seward. The fjords themselves are seen by boat or plane."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A Exit Glacier se llega por carretera desde Seward. Los fiordos solo se ven en barco o avión."
          }
        }
      }
    },
    "access.kova": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No roads reach the park. Fly from Kotzebue or Bettles by air taxi; the night sky means backcountry camping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún camino llega al parque. Vuela en taxi aéreo desde Kotzebue o Bettles; para ver el cielo nocturno hay que acampar en zonas remotas."
          }
        }
      }
    },
    "access.lacl": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not on the road system; most visitors arrive by small plane. Overnight means a lodge or backcountry camping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tiene acceso por carretera; la mayoría llega en avioneta. Pasar la noche significa un albergue o acampar en zonas remotas."
          }
        }
      }
    },
    "access.noca": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SR 20 crosses the park but usually closes past Ross Dam Trailhead, November to April. Stehekin has no road in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La SR 20 cruza el parque, pero suele cerrar más allá de Ross Dam Trailhead de noviembre a abril. A Stehekin no llega ningún camino."
          }
        }
      }
    },
