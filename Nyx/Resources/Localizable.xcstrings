        "ja": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nyxは、天の川の中心部が昇るときなど、夜のある時刻にこのiPadでアラームを設定できます。空の準備が整うまで休んでいられます。アラームは消音モードや集中モードでも鳴ります。このiPadから外には何も送られません。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nyxは、天の川の中心部が昇るときなど、夜のある時刻にこのiPhoneでアラームを設定できます。空の準備が整うまで休んでいられます。アラームは消音モードや集中モードでも鳴ります。このiPhoneから外には何も送られません。"
                }
