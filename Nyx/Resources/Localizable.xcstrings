    "Adding a night to Calendar opens Calendar's own editor, where you choose and save it. Nyx never reads your calendars.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine Nacht zum Kalender hinzufügst, öffnet sich der Editor der Kalender-App, in dem du auswählst und sicherst. Nyx liest deine Kalender nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding a night to Calendar opens Calendar's own editor, where you choose and save it. Nyx never reads your calendars."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregar una noche a Calendario abre el editor de Calendario, donde tú decides y la guardas. Nyx nunca lee tus calendarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une nuit à Calendrier ouvre l’éditeur de Calendrier, où vous choisissez et enregistrez. Nyx ne lit jamais vos calendriers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜をカレンダーに追加すると、カレンダーの編集画面が開き、そこで選んで保存します。Nyxがあなたのカレンダーを読むことはありません。"
          }
        }
      }
    },
