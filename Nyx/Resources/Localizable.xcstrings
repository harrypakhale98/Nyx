    "Under the shape of the night on a park's page, Nyx can play that night as twelve seconds of sound, from sunset to sunrise.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter dem Verlauf der Nacht auf der Seite eines Parks kann Nyx diese Nacht als zwölf Sekunden Klang abspielen, von Sonnenuntergang bis Sonnenaufgang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under the shape of the night on a park's page, Nyx can play that night as twelve seconds of sound, from sunset to sunrise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debajo de la forma de la noche, en la página de un parque, Nyx puede reproducir esa noche en doce segundos de sonido, de la puesta a la salida del sol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous la forme de la nuit, sur la page d’un parc, Nyx peut jouer cette nuit en douze secondes de son, du coucher au lever du soleil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公園のページの「夜のかたち」の下で、Nyxはその夜を日の入りから日の出まで、12秒の音で再生できます。"
          }
        }
      }
    },
