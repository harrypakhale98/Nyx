        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron revisar los programas en la última actualización. Pregunta en el centro de visitantes por los programas de cielo nocturno actuales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les programmes n’ont pas pu être vérifiés lors de la dernière mise à jour. Renseignez-vous au centre d’accueil sur les programmes nocturnes en cours."
