    "The sky glows white or orange, bright enough to read by.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Himmel leuchtet weiß oder orange, hell genug zum Lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sky glows white or orange, bright enough to read by."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cielo brilla blanco o anaranjado, tanto que se puede leer con su luz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ciel luit blanc ou orangé, assez fort pour qu’on puisse lire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空が白やオレンジ色に光り、その明かりで本が読めるほどです。"
          }
        }
      }
    },
    "The sky is still in twilight.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Himmel ist noch in der Dämmerung."
