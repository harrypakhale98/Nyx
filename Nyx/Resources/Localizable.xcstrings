    "%@ %@, Moon down. A rough guide; check clouds and park alerts.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, Mond untergegangen. Eine grobe Orientierung; prüfe Wolken und Parkhinweise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@, Moon down. A rough guide; check clouds and park alerts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, con la Luna oculta. Es una guía aproximada; revisa las nubes y las alertas del parque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, Lune couchée. À titre indicatif ; vérifiez les nuages et les alertes du parc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@、%1$@。月は沈んでいます。目安です。雲と公園のアラートを確認してください。"
          }
        }
      }
    },
