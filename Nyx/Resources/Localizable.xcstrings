    "Says when true darkness begins and ends tonight at a park or dark-sky place, in the park's own time, worked out on this iPhone. Leave the park empty for your starting park.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Sagt, wann die echte Dunkelheit heute Nacht in einem Park oder Dunkelort beginnt und endet, in der Ortszeit des Parks, berechnet auf diesem iPad. Lass den Park leer für deinen Ausgangspark."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Sagt, wann die echte Dunkelheit heute Nacht in einem Park oder Dunkelort beginnt und endet, in der Ortszeit des Parks, berechnet auf diesem iPhone. Lass den Park leer für deinen Ausgangspark."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Says when true darkness begins and ends tonight at a park or dark-sky place, in the park's own time, worked out on this iPad. Leave the park empty for your starting park."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Says when true darkness begins and ends tonight at a park or dark-sky place, in the park's own time, worked out on this iPhone. Leave the park empty for your starting park."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dice cuándo empieza y termina la oscuridad total esta noche en un parque o lugar de cielo oscuro, con la hora del lugar, calculado en este iPad. Deja el parque vacío para usar tu parque de partida."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dice cuándo empieza y termina la oscuridad total esta noche en un parque o lugar de cielo oscuro, con la hora del lugar, calculado en este iPhone. Deja el parque vacío para usar tu parque de partida."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Indique quand l’obscurité totale commence et finit ce soir dans un parc ou un site de ciel étoilé, à l’heure du lieu, calculé sur cet iPad. Laissez le parc vide pour votre parc de départ."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Indique quand l’obscurité totale commence et finit ce soir dans un parc ou un site de ciel étoilé, à l’heure du lieu, calculé sur cet iPhone. Laissez le parc vide pour votre parc de départ."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "公園や暗い空の場所で今夜、完全な暗さがいつ始まりいつ終わるかを、公園の現地時間で伝えます。計算はこのiPadで行います。公園を空欄にすると、出発地の公園を使います。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "公園や暗い空の場所で今夜、完全な暗さがいつ始まりいつ終わるかを、公園の現地時間で伝えます。計算はこのiPhoneで行います。公園を空欄にすると、出発地の公園を使います。"
