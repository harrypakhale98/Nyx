                "stringUnit": {
                  "state": "translated",
                  "value": "Nyx can set an alarm on this iPad for a moment in the night, like the Milky Way's core rising, so you can rest until the sky is ready. Alarms ring through Silent and Focus. Nothing leaves this iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nyx can set an alarm on this iPhone for a moment in the night, like the Milky Way's core rising, so you can rest until the sky is ready. Alarms ring through Silent and Focus. Nothing leaves this phone."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nyx puede poner una alarma en este iPad para un momento de la noche, como la salida del núcleo de la Vía Láctea, para que descanses hasta que el cielo esté listo. Las alarmas suenan aunque estén activados el modo Silencio o Concentración. Nada sale de este iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nyx puede poner una alarma en este iPhone para un momento de la noche, como la salida del núcleo de la Vía Láctea, para que descanses hasta que el cielo esté listo. Las alarmas suenan aunque estén activados el modo Silencio o Concentración. Nada sale de este teléfono."
                }
              }
            }
          }
        }
      }
    },
    "Nyx can't see what you looked at while you were away. Bright light resets dark adaptation.": {
