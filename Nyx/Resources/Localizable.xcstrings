    "Your journal could not be opened, so nothing was read or saved. The Journal tab in Nyx says more.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Journal konnte nicht geöffnet werden, daher wurde nichts gelesen oder gesichert. Der Tab „Journal“ in Nyx sagt mehr dazu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your journal could not be opened, so nothing was read or saved. The Journal tab in Nyx says more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir tu diario, así que no se leyó ni se guardó nada. La pestaña Diario de Nyx tiene más información."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre journal n’a pas pu être ouvert, donc rien n’a été lu ni enregistré. L’onglet Journal de Nyx en dit plus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャーナルを開けなかったため、何も読み込まず、保存もしていません。詳しくはNyxの「ジャーナル」タブを見てください。"
          }
        }
      }
    },
    "Your journal could not be opened, so this file was not imported. Nothing was changed.": {
