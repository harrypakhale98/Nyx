    "Illustration: this park's sky at its estimated Class %lld, and the same sky from a city, Class 8. From a city, the Milky Way and most faint stars disappear; only the brightest stars remain.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Illustration: der Himmel dieses Parks in seiner geschätzten Klasse %lld und derselbe Himmel aus einer Stadt, Klasse 8. In der Stadt verschwinden die Milchstraße und die meisten schwachen Sterne; nur die hellsten bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Illustration: this park's sky at its estimated Class %lld, and the same sky from a city, Class 8. From a city, the Milky Way and most faint stars disappear; only the brightest stars remain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilustración: el cielo de este parque con su clase estimada, %lld, y el mismo cielo desde una ciudad, clase 8. Desde una ciudad, la Vía Láctea y la mayoría de las estrellas tenues desaparecen; solo quedan las más brillantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Illustration : le ciel de ce parc à sa classe estimée, %lld, et le même ciel depuis une ville, classe 8. Depuis une ville, la Voie lactée et la plupart des étoiles faibles disparaissent ; seules les plus brillantes restent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イラスト：推定クラス%lldでのこの公園の空と、クラス8の都市から見た同じ空です。都市からは天の川とほとんどの暗い星が消え、明るい星だけが残ります。"
          }
        }
      }
    },
    "Illustration: this spot's sky at its estimated Class %lld, and the same sky from a city, Class 8. From a city, the Milky Way and most faint stars disappear; only the brightest stars remain.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Illustration: der Himmel dieses Platzes in seiner geschätzten Klasse %lld und derselbe Himmel aus einer Stadt, Klasse 8. In der Stadt verschwinden die Milchstraße und die meisten schwachen Sterne; nur die hellsten bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Illustration: this spot's sky at its estimated Class %lld, and the same sky from a city, Class 8. From a city, the Milky Way and most faint stars disappear; only the brightest stars remain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilustración: el cielo de este sitio con su clase estimada %lld, y el mismo cielo desde una ciudad, clase 8. Desde una ciudad, la Vía Láctea y la mayoría de las estrellas tenues desaparecen; solo quedan las más brillantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Illustration : le ciel de ce lieu à sa classe estimée, %lld, et le même ciel depuis une ville, classe 8. Depuis une ville, la Voie lactée et la plupart des étoiles faibles disparaissent ; seules les plus brillantes restent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イラスト：推定クラス%lldでのこのスポットの空と、クラス8の都市から見た同じ空です。都市からは天の川とほとんどの暗い星が消え、明るい星だけが残ります。"
          }
        }
      }
    },
