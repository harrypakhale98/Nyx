    "Turn the screen red at any time, here or from Control Center. Nyx has no account, no ads, no tracking. Your journal never leaves this phone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Schalte den Bildschirm jederzeit auf Rot, hier oder im Kontrollzentrum. Nyx hat keinen Account, keine Werbung, kein Tracking. Dein Journal verlässt dieses iPad nie."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Schalte den Bildschirm jederzeit auf Rot, hier oder im Kontrollzentrum. Nyx hat keinen Account, keine Werbung, kein Tracking. Dein Journal verlässt dieses iPhone nie."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Turn the screen red at any time, here or from Control Center. Nyx has no account, no ads, no tracking. Your journal never leaves this iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Turn the screen red at any time, here or from Control Center. Nyx has no account, no ads, no tracking. Your journal never leaves this phone."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Pon la pantalla en rojo cuando quieras, aquí o desde el Centro de control. Nyx no tiene cuentas, anuncios ni rastreo. Tu diario nunca sale de este iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Pon la pantalla en rojo cuando quieras, aquí o desde el Centro de control. Nyx no tiene cuentas, anuncios ni rastreo. Tu diario nunca sale de este teléfono."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Passez l’écran en rouge à tout moment, ici ou depuis le centre de contrôle. Nyx n’a ni compte, ni publicité, ni pistage. Votre journal ne quitte jamais cet iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Passez l’écran en rouge à tout moment, ici ou depuis le centre de contrôle. Nyx n’a ni compte, ni publicité, ni pistage. Votre journal ne quitte jamais cet iPhone."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ここかコントロールセンターから、いつでも画面を赤くできます。Nyxにはアカウントも広告もトラッキングもありません。ジャーナルがこのiPadの外に出ることはありません。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ここかコントロールセンターから、いつでも画面を赤くできます。Nyxにはアカウントも広告もトラッキングもありません。ジャーナルがこのiPhoneの外に出ることはありません。"
                }
              }
            }
          }
        }
      }
    },
    "Turning updates off prevents new requests. Previously cached data remains available. Moon, twilight, Plan, saved parks and the journal work offline.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du Aktualisierungen ausschaltest, werden keine neuen Anfragen gestellt. Bereits gespeicherte Daten bleiben verfügbar. Mond, Dämmerung, „Planen“, gespeicherte Parks und das Journal funktionieren offline."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning updates off prevents new requests. Previously cached data remains available. Moon, twilight, Plan, saved parks and the journal work offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar las actualizaciones evita nuevas solicitudes. Los datos guardados antes siguen disponibles. La Luna, el crepúsculo, Planear, los parques guardados y el diario funcionan sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver les mises à jour empêche toute nouvelle requête. Les données déjà en cache restent disponibles. La Lune, le crépuscule, Planifier, les parcs enregistrés et le journal fonctionnent hors ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新をオフにすると、新しいリクエストは送信されません。保存済みのデータは引き続き使えます。月、薄明、計画、保存した公園、ジャーナルはオフラインでも使えます。"
          }
        }
      }
    },
    "Turns on Nyx's red night-vision palette and offers field mode while this Focus is on.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet die rote Nachtsicht-Palette von Nyx ein und bietet den Feldmodus an, solange dieser Fokus aktiv ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns on Nyx's red night-vision palette and offers field mode while this Focus is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la paleta roja de visión nocturna de Nyx y ofrece el modo de campo mientras este modo de concentración esté activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active la palette rouge de vision nocturne de Nyx et propose le mode terrain tant que ce mode de concentration est activé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この集中モードがオンの間、Nyxを赤いナイトビジョンの配色にし、フィールドモードを提案します。"
          }
        }
      }
    },
    "Turns on Nyx's red night-vision palette, for eyes adapted to the dark. Widgets and the Lock Screen follow.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet die rote Nachtsicht-Palette von Nyx ein, für an die Dunkelheit angepasste Augen. Widgets und Sperrbildschirm folgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns on Nyx's red night-vision palette, for eyes adapted to the dark. Widgets and the Lock Screen follow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la paleta roja de visión nocturna de Nyx, para ojos adaptados a la oscuridad. Los widgets y la pantalla de bloqueo la siguen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active la palette rouge de vision nocturne de Nyx, pour des yeux adaptés à l’obscurité. Les widgets et l’écran verrouillé suivent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗さに慣れた目のために、Nyxを赤いナイトビジョンの配色にします。ウィジェットとロック画面も同じ配色になります。"
          }
        }
      }
    },
    "Turns the screen red. You can change it any time.": {
