    "It leaves your saved places, widgets and reminders. Journal entries written there keep their words and photos.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er verschwindet aus deinen gespeicherten Orten, Widgets und Erinnerungen. Journaleinträge von dort behalten ihre Worte und Fotos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It leaves your saved places, widgets and reminders. Journal entries written there keep their words and photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale de tus lugares guardados, los widgets y los recordatorios. Las entradas del diario escritas allí conservan sus palabras y fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il quitte vos lieux enregistrés, vos widgets et vos rappels. Les entrées du journal écrites là-bas gardent leurs mots et leurs photos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した場所、ウィジェット、リマインダーから削除されます。そこで書いたジャーナルの記録は、文章も写真もそのまま残ります。"
          }
        }
      }
    },
    "It plays even when your iPhone is set to silent, because you asked for it, and other audio lowers while it plays. A transcript is always beside the button.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die Wiedergabe läuft auch, wenn dein iPad stummgeschaltet ist, weil du sie gestartet hast, und anderer Ton wird währenddessen leiser. Neben der Taste steht immer ein Transkript."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die Wiedergabe läuft auch, wenn dein iPhone stummgeschaltet ist, weil du sie gestartet hast, und anderer Ton wird währenddessen leiser. Neben der Taste steht immer ein Transkript."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "It plays even when your iPad is set to silent, because you asked for it, and other audio lowers while it plays. A transcript is always beside the button."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "It plays even when your iPhone is set to silent, because you asked for it, and other audio lowers while it plays. A transcript is always beside the button."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Suena aunque el iPad esté en modo Silencio, porque tú lo pediste, y el resto del audio baja mientras suena. Siempre hay una transcripción junto al botón."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Suena aunque el iPhone esté en modo Silencio, porque tú lo pediste, y el resto del audio baja mientras suena. Siempre hay una transcripción junto al botón."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Il est lu même quand votre iPad est en mode silencieux, puisque vous l’avez demandé, et les autres sons baissent pendant la lecture. Une transcription est toujours à côté du bouton."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Il est lu même quand votre iPhone est en mode silencieux, puisque vous l’avez demandé, et les autres sons baissent pendant la lecture. Une transcription est toujours à côté du bouton."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "あなたが選んで再生したので、iPadが消音モードでも再生されます。再生中はほかのオーディオの音量が下がります。ボタンの横には、いつも文字起こしが表示されます。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "あなたが選んで再生したので、iPhoneが消音モードでも再生されます。再生中はほかのオーディオの音量が下がります。ボタンの横には、いつも文字起こしが表示されます。"
                }
              }
            }
          }
        }
      }
    },
    "It sets in the %@. Moon-free true darkness from here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er geht im %@ unter. Ab hier echte Dunkelheit ohne Mond."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It sets in the %@. Moon-free true darkness from here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pone en el %@. Desde aquí, oscuridad total sin Luna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle se couche direction %@. Obscurité totale sans Lune à partir de maintenant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の空に沈みます。ここからは月のない完全な暗さです。"
          }
        }
      }
    },
    "Its Bortle class is estimated from satellite data, not measured here. Nyx has no viewing spots or ranger programs for it yet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Bortle-Klasse ist aus Satellitendaten geschätzt, hier nicht gemessen. Nyx hat dafür noch keine Beobachtungsplätze oder Ranger-Programme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its Bortle class is estimated from satellite data, not measured here. Nyx has no viewing spots or ranger programs for it yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su clase Bortle es una estimación con datos satelitales, no una medición hecha aquí. Nyx aún no tiene puntos de observación ni programas con guardaparques para este lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa classe de Bortle est estimée à partir de données satellite, pas mesurée ici. Nyx n’a pas encore de points d’observation ni de programmes de rangers pour ce lieu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボートルクラスは衛星データからの推定値で、ここで測定したものではありません。Nyxには、ここの観察スポットやレンジャープログラムの情報はまだありません。"
          }
        }
      }
    },
    "Its bright center clears 10° in the %@.": {
