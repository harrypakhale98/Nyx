          }
        }
      }
    },
    "Zodiacal light may show in the east before dawn: a faint cone of sunlit dust rising along the Sun's path.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodiacal light may show in the east before dawn: a faint cone of sunlit dust rising along the Sun's path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz zodiacal puede verse al este antes del amanecer: un cono tenue de polvo iluminado por el Sol que sube siguiendo su trayectoria."
          }
        }
      }
    },
    "Zodiacal light may show in the west after dusk: a faint cone of sunlit dust rising along the Sun's path.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodiacal light may show in the west after dusk: a faint cone of sunlit dust rising along the Sun's path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz zodiacal puede verse al oeste después del anochecer: un cono tenue de polvo iluminado por el Sol que sube siguiendo su trayectoria."
          }
        }
      }
    },
    "a national park": {
      "extractionState": "manual",
      "localizations": {
