          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Índice de ejemplo 94 de 100. Parte del índice: luz de luna 40 por ciento, nubes 25, resplandor 20 y oscuridad total 15. 90 o más es Prístina, 75 Excelente, 60 Buena."
