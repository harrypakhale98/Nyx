        }
      }
    },
    "The icon stays in the phase you choose; it does not follow the Moon.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Symbol bleibt in der Phase, die du wählst; es folgt nicht dem Mond."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The icon stays in the phase you choose; it does not follow the Moon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ícono se queda en la fase que elijas; no sigue a la Luna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’icône garde la phase que vous choisissez ; elle ne suit pas la Lune."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンは選んだ月の形のままで、実際の月の満ち欠けには合わせません。"
          }
        }
      }
    },
    "The journal could not be exported. Try again when space is available.": {
