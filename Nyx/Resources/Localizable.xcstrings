    "No Milky Way; the whole sky has a gray-white glow.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Milchstraße; der ganze Himmel hat einen grauweißen Schein."
          }
        },
