    "Plays a tone in your headphones from the direction of a target in the sky.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt in deinen Kopfhörern einen Ton aus der Richtung eines Ziels am Himmel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays a tone in your headphones from the direction of a target in the sky."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce un tono en tus audífonos desde la dirección de un objetivo en el cielo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue un son dans vos écouteurs depuis la direction d’une cible dans le ciel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空にある対象の方向から、ヘッドフォンで音を鳴らします。"
          }
        }
      }
    },
    "Plays the Moon's phase as a texture: sharp, sparse taps for a new moon, a broad swell for a full moon.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt die Mondphase als Textur: kurze, vereinzelte Tipper für einen Neumond, ein breites Anschwellen für einen Vollmond."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays the Moon's phase as a texture: sharp, sparse taps for a new moon, a broad swell for a full moon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce la fase de la Luna como una textura: toques breves y espaciados para una luna nueva, una ola amplia para una luna llena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue la phase de la Lune comme une texture : des coups brefs et espacés pour une nouvelle lune, une large houle pour une pleine lune."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月の満ち欠けを触感として再生します。新月はまばらで鋭いタップ、満月は大きく広がる高まりです。"
          }
        }
      }
    },
    "Plays the night from sunset to sunrise as twelve seconds of sound.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt die Nacht von Sonnenuntergang bis Sonnenaufgang als zwölf Sekunden Klang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays the night from sunset to sunrise as twelve seconds of sound."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce la noche, de la puesta a la salida del sol, en doce segundos de sonido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue la nuit, du coucher au lever du soleil, en douze secondes de son."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日の入りから日の出までの夜を、12秒の音で再生します。"
          }
        }
      }
    },
    "Plays the night from sunset to sunrise as twenty-four seconds of touch.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
