    "Nyx can remind you about promising nights at saved parks. These notifications are scheduled on this iPhone. They are estimates, not confirmations of clear skies or access.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nyx kann dich an vielversprechende Nächte in gespeicherten Parks erinnern. Diese Mitteilungen werden auf diesem iPad geplant. Sie sind Schätzungen, keine Bestätigung von klarem Himmel oder Zugang."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nyx kann dich an vielversprechende Nächte in gespeicherten Parks erinnern. Diese Mitteilungen werden auf diesem iPhone geplant. Sie sind Schätzungen, keine Bestätigung von klarem Himmel oder Zugang."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nyx can remind you about promising nights at saved parks. These notifications are scheduled on this iPad. They are estimates, not confirmations of clear skies or access."
                }
              },
              "other": {
