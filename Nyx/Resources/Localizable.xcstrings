          }
        }
      }
    },
    "The published peak rate is %lld an hour under a perfect sky, with the radiant, the point the meteors seem to come from, overhead (International Meteor Organization); it varies from year to year.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The published peak rate is %lld an hour under a perfect sky, with the radiant, the point the meteors seem to come from, overhead (International Meteor Organization); it varies from year to year."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tasa máxima publicada es de %lld por hora con un cielo perfecto y el radiante, el punto del que parecen salir los meteoros, en el cenit (Organización Internacional de Meteoros); varía de un año a otro."
          }
        }
      }
    },
    "The ring marks the five nights with the least moonlight. Clouds and access may change the best choice.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ring marks the five nights with the least moonlight. Clouds and access may change the best choice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El anillo marca las cinco noches con menos luz de luna. Las nubes y el acceso pueden cambiar la mejor opción."
          }
        }
      }
    },
    "The route": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The route"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ruta"
          }
        }
      }
    },
