          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin oscuridad total a esta latitud, se verán pocos meteoros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans obscurité totale à cette latitude, peu de météores seront visibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この緯度では完全に暗くならないため、見える流星はわずかです。"
