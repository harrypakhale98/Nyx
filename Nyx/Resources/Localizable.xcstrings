    "Photos are accessed only through the system photo picker. Reminders and alarms are local. In field mode, Nyx uses motion on this iPhone to point the sky where you hold it; nothing is recorded.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Auf Fotos wird nur über die Fotoauswahl des Systems zugegriffen. Erinnerungen und Wecker sind lokal. Im Feldmodus nutzt Nyx die Bewegung dieses iPad, um den Himmel dorthin auszurichten, wohin du es hältst; nichts wird aufgezeichnet."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Auf Fotos wird nur über die Fotoauswahl des Systems zugegriffen. Erinnerungen und Wecker sind lokal. Im Feldmodus nutzt Nyx die Bewegung dieses iPhone, um den Himmel dorthin auszurichten, wohin du es hältst; nichts wird aufgezeichnet."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Photos are accessed only through the system photo picker. Reminders and alarms are local. In field mode, Nyx uses motion on this iPad to point the sky where you hold it; nothing is recorded."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Photos are accessed only through the system photo picker. Reminders and alarms are local. In field mode, Nyx uses motion on this iPhone to point the sky where you hold it; nothing is recorded."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Las fotos solo se abren con el selector de fotos del sistema. Los recordatorios y las alarmas son locales. En modo de campo, Nyx usa el movimiento de este iPad para orientar el cielo hacia donde lo sostienes; no se registra nada."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Las fotos solo se abren con el selector de fotos del sistema. Los recordatorios y las alarmas son locales. En modo de campo, Nyx usa el movimiento de este iPhone para orientar el cielo hacia donde lo sostienes; no se registra nada."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les photos ne sont accessibles que par le sélecteur de photos du système. Les rappels et les alarmes sont locaux. En mode terrain, Nyx utilise les mouvements de cet iPad pour orienter le ciel là où vous le tenez ; rien n’est enregistré."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les photos ne sont accessibles que par le sélecteur de photos du système. Les rappels et les alarmes sont locaux. En mode terrain, Nyx utilise les mouvements de cet iPhone pour orienter le ciel là où vous le tenez ; rien n’est enregistré."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "写真には、システムの写真ピッカーを通してだけアクセスします。リマインダーとアラームはローカルです。フィールドモードでは、このiPadのモーションを使って、かざした方向に空を合わせます。何も記録しません。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "写真には、システムの写真ピッカーを通してだけアクセスします。リマインダーとアラームはローカルです。フィールドモードでは、このiPhoneのモーションを使って、かざした方向に空を合わせます。何も記録しません。"
                }
              }
            }
          }
        }
      }
    },
